---
interface Props {
  desc?: string;
  hero_image?: string;
  villageName?: string;
}

const { desc = "", hero_image, villageName = "Desa Umbu Pabal" } = Astro.props;

const fallbackImage =
  "https://lh3.googleusercontent.com/aida-public/AB6AXuBv5DzSDYSZ0VOEhEY_mGSUnKm-rrLSNmRcWk7Lr-kUqaYmloeL5G3-l2QKEsYizA6SW70l0smWakk9dySRxsv9RyGFGGX0nRBxYWIR4GwpAuoo8-zeO03C2Q2uf4HiXWujYpV6dgCCK4RooD8VygOME97TkNWHAEicqCC6579HmjcRajMA-z6Ry4EGZz8jeGdG-8Z3bjdIlsdmZvkclJP-W9p01zJEfdE5vDv-LDGCJvE6RSX9oVByXnwGXgGh-NYEJhWpARFWKvs";
---

<section
  class="relative h-153.5 flex items-center justify-center overflow-hidden transition-all duration-700 opacity-100 translate-y-0"
>
  <div class="absolute inset-0 z-0">
    <img
      alt={`${villageName} Landscape`}
      class="w-full h-full object-cover"
      src={hero_image || fallbackImage}
    />
    <div class="absolute inset-0 bg-linear-to-b from-primary/40 to-primary/80">
    </div>
  </div>
  <div class="relative z-10 text-center text-white px-gutter">
    <h1 class="text-2xl font-headline-xl sm:text-headline-xl mb-4">
      Tentang {villageName}
    </h1>
    <p class="font-body-lg text-body-lg max-w-2xl mx-auto text-primary-fixed">
      {desc || "Mewujudkan Digital Stewardship: Memadukan nilai tradisional dengan tata kelola modern untuk kesejahteraan seluruh warga."}
    </p>
  </div>
</section>
