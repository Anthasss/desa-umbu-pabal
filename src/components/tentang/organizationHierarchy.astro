<section
  class="py-section-padding-desktop px-gutter max-w-container-max mx-auto border-t border-outline-variant/30 transition-all duration-700 opacity-100 translate-y-0"
>
  <div class="text-center mb-16">
    <h2 class="font-headline-lg text-headline-lg text-primary">
      Struktur Organisasi
    </h2>
    <p class="text-on-surface-variant font-body-md text-body-md mt-4">
      Kepemimpinan yang berdedikasi melayani kepentingan warga.
    </p>
  </div>

  <div class="space-y-16">
    <!-- Village Head -->
    <div class="flex justify-center">
      <div class="group relative w-full max-w-sm">
        <div
          class="bg-surface border border-outline-variant rounded-xl overflow-hidden shadow-sm group-hover:shadow-lg transition-all text-center p-6"
        >
          <div
            class="w-32 h-32 mx-auto mb-4 rounded-full overflow-hidden border-4 border-primary-fixed"
          >
            <img
              alt={villageHead.role}
              class="w-full h-full object-cover"
              src={villageHead.image}
            />
          </div>
          <h3 class="font-headline-md text-headline-md text-primary">
            {villageHead.name}
          </h3>
          <span
            class="text-secondary font-label-md uppercase tracking-wider block mt-1"
            >{villageHead.role}</span
          >
        </div>
      </div>
    </div>

    <!-- Staff -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        staffMembers.map((member) => (
          <div class="bg-surface border border-outline-variant rounded-xl overflow-hidden p-6 text-center shadow-sm">
            <div class="w-32 h-32 mx-auto mb-4 rounded-full overflow-hidden border-2 border-primary-fixed">
              <img
                alt={member.role}
                class="w-full h-full object-cover"
                src={member.image}
              />
            </div>
            <h4 class="font-headline-md text-headline-md text-primary">
              {member.name}
            </h4>
            <span class="text-secondary font-label-md uppercase tracking-wider block">
              {member.role}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
