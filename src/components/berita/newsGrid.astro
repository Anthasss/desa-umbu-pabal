---
import CategoryFilter from "./categoryFilter.astro";
import NewsCard from "./newsCard.astro";
import { newsItems } from "../../data/berita";
---

<section
  class="bg-surface-container-low py-12 md:py-section-padding-desktop md:pt-4"
>
  <div class="max-w-container-max mx-auto px-gutter">
    <div
      class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6"
    >
      <div class="flex gap-4">
        <div class="relative flex-1 max-w-md">
          <span
            class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline"
          >
            search
          </span>
          <input
            class="w-full pl-12 pr-4 py-3 bg-surface-container-lowest border border-outline-variant rounded-xl focus:outline-none focus:border-primary transition-colors"
            placeholder="Cari berita..."
            type="text"
          />
        </div>
      </div>
      <CategoryFilter />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
      {newsItems.map((item) => <NewsCard item={item} />)}
    </div>
  </div>
</section>
