---
import { categories } from "../../data/berita";
---

<div class="flex gap-2 overflow-x-auto pb-2 w-full md:w-auto">
  {
    categories.map((cat, index) => (
      <button
        class:list={[
          "px-6 py-2 rounded-full font-label-md whitespace-nowrap transition-colors",
          index === 0
            ? "bg-primary text-on-primary"
            : "bg-surface-container-lowest border border-outline-variant text-on-surface-variant hover:bg-primary-fixed",
        ]}
      >
        {cat}
      </button>
    ))
  }
</div>
