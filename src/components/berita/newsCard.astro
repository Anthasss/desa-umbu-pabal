---
import { categoryStyles, type NewsItem } from "../../data/berita";

interface Props {
  item: NewsItem;
}

const { item } = Astro.props;
---

<div
  class="bg-surface-container-lowest rounded-xl border border-outline-variant overflow-hidden group hover:shadow-lg transition-all duration-300"
>
  <div class="h-56 overflow-hidden relative">
    <img
      alt={item.title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      src={item.image}
    />
    <div class="absolute top-4 left-4">
      <span
        class:list={[
          "backdrop-blur-md text-[12px] font-bold px-3 py-1 rounded uppercase tracking-wider",
          categoryStyles[item.category],
        ]}
      >
        {item.category}
      </span>
    </div>
  </div>
  <div class="p-6">
    <span class="text-on-surface-variant text-label-md block mb-2"
      >{item.date}</span
    >
    <a href={`/berita/${item.slug}`}>
      <h3
        class="font-headline-md text-headline-md text-on-surface mb-3 group-hover:text-secondary transition-colors font-bold text-lg leading-snug"
      >
        {item.title}
      </h3>
    </a>
    <p class="text-on-surface-variant text-body-md mb-6 line-clamp-3">
      {item.excerpt}
    </p>

    class="inline-flex items-center gap-2 text-secondary font-label-md
    group/link font-bold hover:underline" href={`/berita/${item.slug}`}
    > Selengkapnya
    <span
      class="material-symbols-outlined text-[18px] group-hover/link:translate-x-1 transition-transform"
    >
      arrow_forward
    </span>
  </div>
</div>
