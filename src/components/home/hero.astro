---
interface Props {
  hero_title: string;
  hero_desc: string;
  hero_image?: string;
}

const { hero_title, hero_desc, hero_image } = Astro.props as Props;

const fallbackImage =
  "https://lh3.googleusercontent.com/aida-public/AB6AXuBiKmOT9fCF7j9lL9KM8c7tL8nZh-5J5bUWkMzfeMxbNSX6Xj-tJPISJquc0D0hJ7lqfLjqWrDYvgMUXUr7iaYP0jKP0jQDwL4ketlDDP5N73nBIONqqKsmeqh_hgm_72Hg-1ziye0CK5eZ5jJ4BjWNid80PtTI9B45qZPZqcBQ08tHvTbzsN7IWsNIzZfwwFRUZjPL-_jm5NrCISBQ68EcQ_FXq_DzNbfx_o_SkNGYHOaOiK6pgSFB7h9KyUtN-p9KrI9r7mvLmD4";
---

<section class="relative h-screen flex items-center overflow-hidden">
  <!-- NOTE: bg image -->
  <div class="absolute inset-0 z-0">
    <img
      class="w-full h-full object-cover"
      alt="A panoramic wide-angle photograph of a lush, emerald-green Indonesian village nestled in a misty valley at dawn."
      src={hero_image || fallbackImage}
      id="heroImage"
    />
    <div class="absolute inset-0 bg-linear-to-r from-primary/60 to-transparent">
    </div>
  </div>

  <!-- NOTE: hero content -->
  <div class="relative z-10 max-w-container-max mx-auto px-gutter w-full">
    <div class="max-w-2xl text-on-primary">
      <!-- NOTE: small breakpoint texts -->
      <div class="hidden sm:inline-block w-full text-on-primary">
        <span
          class="inline-block px-4 py-1 bg-primary text-on-primary rounded-full font-label-md mb-6"
        >
          Selamat Datang di Desa Umbu Pabal
        </span>
        <h1
          class="inline-block font-headline-xl text-headline-xl mb-6 leading-tight"
        >
          {hero_title}
        </h1>
        <p class="font-body-lg text-body-lg mb-8 opacity-90">{hero_desc}</p>
      </div>

      <!-- NOTE: mobile texts -->
      <div class="mb-8 md:hidden">
        <p class="text-3xl font-bold">
          Selamat datang di <br />Desa Umbu Pabal
        </p>
      </div>

      <!-- NOTE: buttons -->
      <div class="flex flex-wrap gap-4">
        <a
          href="/tentang"
          class="text-sm md:text-lg bg-[#D4AF37] text-[#191c1d] px-8 py-4 rounded-xl font-label-md hover:shadow-lg transition-all text-center"
        >
          Jelajahi Desa
        </a>
        <!-- <a -->
        <!--   href="/" -->
        <!--   class="text-sm md:text-lg border-2 border-on-primary text-on-primary px-8 py-4 rounded-xl font-label-md hover:bg-on-primary/10 transition-all text-center" -->
        <!-- > -->
        <!--   Layanan Publik -->
        <!-- </a> -->
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Hero scroll parallax effect
  window.addEventListener("scroll", () => {
    const scrolled = window.pageYOffset;
    const heroImage = document.getElementById("heroImage");
    if (heroImage) {
      heroImage.style.transform = `translateY(${scrolled * 0.4}px)`;
    }
  });
</script>
