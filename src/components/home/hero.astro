  <!-- NOTE: hero content -->
  <div class="relative z-10 max-w-container-max mx-auto px-gutter w-full">
    <div class="max-w-2xl text-on-primary">
      <!-- NOTE: texts -->
      <span
        class="inline-block px-4 py-1 bg-primary text-on-primary rounded-full font-label-md mb-6"
