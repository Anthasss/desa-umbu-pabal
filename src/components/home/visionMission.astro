---
const visionMissionDesc =
  "Panduan strategis kami dalam mewujudkan Desa Umbu Pabal sebagai pusat ekonomi kreatif dan kelestarian alam.";

const missions = [
  {
    title: "Transformasi Digital",
    description:
      "Mengintegrasikan teknologi dalam setiap layanan administrasi dan edukasi masyarakat.",
  },
  {
    title: "Pelayanan Terpadu",
    description:
      "Memberikan pelayanan yang cepat, transparan, dan mudah diakses oleh masyarakat.",
  },
  {
    title: "Pemberdayaan Masyarakat",
    description:
      "Mendorong partisipasi aktif masyarakat dalam pembangunan desa.",
  },
];
---

<section
  class="py-section-padding-desktop bg-primary-container text-on-primary relative overflow-hidden"
>
  <!-- NOTE: grid background -->
  <div class="absolute inset-0 opacity-10 pointer-events-none">
    <div class="grid grid-cols-6 h-full w-full">
      <div class="border-r border-on-primary-container"></div>
      <div class="border-r border-on-primary-container"></div>
      <div class="border-r border-on-primary-container"></div>
      <div class="border-r border-on-primary-container"></div>
      <div class="border-r border-on-primary-container"></div>
    </div>
  </div>

  <div class="max-w-container-max mx-auto px-gutter relative z-10">
    <!-- NOTE: title and description -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="font-headline-lg text-headline-lg mb-6">Visi &amp; Misi</h2>
      <p class="text-primary-fixed opacity-90 text-body-lg">
        {visionMissionDesc}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <!-- NOTE: Vision -->
      <div class="glass-effect p-10 rounded-[40px] text-primary">
        <div class="flex items-center gap-6 mb-8">
          <div
            class="bg-primary-container w-16 h-16 rounded-2xl shrink-0 flex items-center justify-center"
          >
            <span class="material-symbols-outlined text-on-primary text-3xl"
              >visibility</span
            >
          </div>
          <h3 class="font-headline-md text-headline-md">Visi Kami</h3>
        </div>
        <p class="font-body-lg leading-relaxed">
          "Menjadi desa digital percontohan nasional yang mandiri secara
          ekonomi, unggul dalam sumber daya manusia, dan tetap menjaga
          kelestarian ekosistem hutan tropis."
        </p>
      </div>

      <!-- NOTE: Mission -->
      <div class="space-y-6">
        <h3 class="font-headline-md text-headline-md mb-8">Misi Kami</h3>
        {
          missions.map((mission, index) => (
            <div class="flex gap-6 group">
              <div class="shrink-0 w-12 h-12 rounded-full border border-primary-fixed flex items-center justify-center font-bold text-xl group-hover:bg-primary-fixed group-hover:text-primary transition-all">
                {index + 1}
              </div>

              <div>
                <h4 class="font-headline-md text-lg mb-2">{mission.title}</h4>

                <p class="text-primary-fixed opacity-70">
                  {mission.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
