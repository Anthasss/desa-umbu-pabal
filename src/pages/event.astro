---
import Layout from "../layouts/Layout.astro";
import { auth } from "../lib/auth";

export const prerender = false;

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});
---

<Layout title="Agenda Kegiatan Desa Umbu Pabal" activePage="event" session={session}>
  <!-- Hero Section -->
  <section class="hero-pattern py-section-padding-mobile md:py-section-padding-desktop">
    <div class="max-w-container-max mx-auto px-gutter text-center">
      <h1 class="font-headline-xl-mobile md:font-headline-xl text-headline-xl-mobile md:text-headline-xl text-primary mb-6 font-bold text-3xl md:text-4xl">
        Agenda &amp; Kegiatan Desa
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">
        Menjalin kebersamaan melalui berbagai kegiatan inspiratif. Temukan jadwal pertemuan warga, festival budaya, dan program pengembangan komunitas kami.
      </p>
    </div>
  </section>

  <!-- Featured Event Section -->
  <section class="py-section-padding-mobile md:py-section-padding-desktop bg-surface-container-low">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="flex flex-col lg:flex-row gap-12 items-center bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm border border-outline-variant">
        <div class="w-full lg:w-1/2 h-[400px]">
          <img 
            alt="Featured Event" 
            class="w-full h-full object-cover" 
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuADY9NPXMhuQxeGCTwwiXWJJ4WTUDEVpAN4dHNnk3Jh76_MlLcggGDLwvXBgeDZWNT4sHCZyvGubAqPxheXE7ZdAiz4wqaowJUG7qAoIcHgJn-rvMvG_iGQm3-w12DBkbYBHuo3MwI7sD8FgOFHCipQC_4LdFtJhycK4LLrV7f19bLXF262TlOzgN6DwLX-u-qEpicUn3KQ-eM8eW5p_3wJjSDQ-S4jKBY5jlDH2w0mhbJ6mo9WRkgmQML9E5UtFU22j7rnr8GThXw"
          />
        </div>
        <div class="w-full lg:w-1/2 p-8 md:p-12">
          <div class="inline-block px-4 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-md mb-6 font-bold text-xs">
            MAJOR EVENT
          </div>
          <h2 class="font-headline-lg text-headline-lg text-primary mb-4 text-2xl font-bold">Festival Budaya Desa Umbu Pabal</h2>
          <p class="font-body-md text-body-md text-on-surface-variant mb-8 leading-relaxed">
            Perayaan tahunan warisan budaya dan keindahan alam Desa Umbu Pabal. Saksikan pertunjukan seni tradisional, pameran kuliner lokal, dan kompetisi kerajinan tangan dari seluruh dusun.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-secondary">calendar_today</span>
              <span class="font-body-md font-semibold">25 - 27 Agustus 2024</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-secondary">schedule</span>
              <span class="font-body-md font-semibold">08:00 - 22:00 WIB</span>
            </div>
            <div class="flex items-center gap-3 col-span-1 md:col-span-2">
              <span class="material-symbols-outlined text-secondary">location_on</span>
              <span class="font-body-md font-semibold text-on-surface">Alun-Alun Pusat Desa</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Upcoming Events Grid -->
  <section class="py-section-padding-mobile md:py-section-padding-desktop">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
        <div>
          <h2 class="font-headline-lg text-headline-lg text-primary mb-2 text-2xl font-bold">Kegiatan Mendatang</h2>
          <p class="font-body-md text-body-md text-on-surface-variant">Pastikan Anda tidak melewatkan agenda penting pembangunan dan sosial desa.</p>
        </div>
        <div class="flex gap-2">
          <button class="p-2 rounded-full border border-outline hover:bg-surface-container transition-colors focus:outline-none">
            <span class="material-symbols-outlined">chevron_left</span>
          </button>
          <button class="p-2 rounded-full border border-outline hover:bg-surface-container transition-colors focus:outline-none">
            <span class="material-symbols-outlined">chevron_right</span>
          </button>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Event Card 1 -->
        <div class="bg-surface rounded-xl overflow-hidden border border-outline-variant hover:shadow-md transition-shadow group cursor-pointer">
          <div class="h-48 overflow-hidden relative">
            <img 
              alt="Village Planning Meeting" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuBFkhrRQ4nn8OGajAlQnNHVX7xDDRFEpagY9BaL2Jd3rqdfEKyQSdXDyCLl-abzL1tnuei9ts-MhW6fVgoOKiG3HYNxiuqrWMlQOU7PAuSRoWRNszR0VqUdJYoj1_AfPWVCBMIWbEXkLb34mrofM94tBlIJwltZ5ZToMhRFHhRoRXeb-fIoUfXdJSFqruYNuw5Omwujpm2Xl94dlwOSLxjOzUws3Gnb2fzGBG8_qxUh3fEWPM41mFsN9HL9K4iiWX3ChRwQHD50L0s"
            />
            <div class="absolute top-4 left-4 bg-white/90 backdrop-blur px-3 py-1 rounded text-primary font-bold text-center shadow">
              <div class="text-xs uppercase">Mei</div>
              <div class="text-xl">15</div>
            </div>
          </div>
          <div class="p-6">
            <span class="text-[12px] font-bold text-secondary uppercase tracking-wider">Pemerintahan</span>
            <h3 class="font-headline-md text-headline-md text-on-surface mt-2 mb-4 leading-tight font-bold text-lg">Musyawarah Perencanaan Pembangunan</h3>
            <div class="flex items-center gap-2 text-on-surface-variant mb-6">
              <span class="material-symbols-outlined text-sm">location_on</span>
              <span class="text-sm">Balai Desa Desa Umbu Pabal</span>
            </div>
          </div>
        </div>
        
        <!-- Event Card 2 -->
        <div class="bg-surface rounded-xl overflow-hidden border border-outline-variant hover:shadow-md transition-shadow group cursor-pointer">
          <div class="h-48 overflow-hidden relative">
            <img 
              alt="Digital MSME Training" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuA-juyatjSCATBr9W9NoGYeTKY8rtrs3tuHllQiUU4Ll-HdYQ43CVriqPswEuUHb2buwF_DUKf5hh7rrizfPUh270RpV1j19FW0E44LIBYIt5AiKt-NOwSx-qtO2Lm41lfYQJRJmkR_2t_RDICSFXk37wLDUpxWsOWyYrpCurQ_GkVzo-72dI1ZTNdjtR63GsVtPFGEDUVYvd6m1M1y4cbZCAJzsZsbCybEDiFVOoF432JyoEss2E4ww5lAUv-ojc4h2IWTshXqMNM"
            />
            <div class="absolute top-4 left-4 bg-white/90 backdrop-blur px-3 py-1 rounded text-primary font-bold text-center shadow">
              <div class="text-xs uppercase">Mei</div>
              <div class="text-xl">20</div>
            </div>
          </div>
          <div class="p-6">
            <span class="text-[12px] font-bold text-secondary uppercase tracking-wider">Ekonomi</span>
            <h3 class="font-headline-md text-headline-md text-on-surface mt-2 mb-4 leading-tight font-bold text-lg">Pelatihan UMKM Digital</h3>
            <div class="flex items-center gap-2 text-on-surface-variant mb-6">
              <span class="material-symbols-outlined text-sm">location_on</span>
              <span class="text-sm">Ruang Komunitas Digital</span>
            </div>
          </div>
        </div>
        
        <!-- Event Card 3 -->
        <div class="bg-surface rounded-xl overflow-hidden border border-outline-variant hover:shadow-md transition-shadow group cursor-pointer">
          <div class="h-48 overflow-hidden relative">
            <img 
              alt="Community Cleanup" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDAfS_1ka6qLTyM7ktX5uRHXOanV3nMInO-uWIN0Y2_GVSCLSk8uEtZ5T-SCXchrFvYa2AzKLEmkNkK0ZsaFKlvf-DD15evyz4gLYD5_UAs7NLdSxiuwscKjT1f-rV_dkFNqMsmdgM5zv5AJqsVDO8ZNysey2-pFIw9KYei4ZYYqLlY1KlzHJxv-pAOE8B8lGQP4LRhlFH0dpMljqNAf6G5l6eEvIHZ9oi3Uyege1xyNHA-Vbu5lF_EJ9Oo68jUoogd_PJtvkSCsdw"
            />
            <div class="absolute top-4 left-4 bg-white/90 backdrop-blur px-3 py-1 rounded text-primary font-bold text-center shadow">
              <div class="text-xs uppercase">Mei</div>
              <div class="text-xl">25</div>
            </div>
          </div>
          <div class="p-6">
            <span class="text-[12px] font-bold text-secondary uppercase tracking-wider">Lingkungan</span>
            <h3 class="font-headline-md text-headline-md text-on-surface mt-2 mb-4 leading-tight font-bold text-lg">Kerja Bakti Lingkungan</h3>
            <div class="flex items-center gap-2 text-on-surface-variant mb-6">
              <span class="material-symbols-outlined text-sm">location_on</span>
              <span class="text-sm">Taman Desa Sektor 4</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter / CTA -->
  <section class="py-section-padding-mobile md:py-section-padding-desktop bg-primary text-on-primary">
    <div class="max-w-container-max mx-auto px-gutter text-center">
      <h2 class="font-headline-lg text-headline-lg mb-4 text-2xl font-bold">Jangan Lewatkan Agenda Berikutnya</h2>
      <p class="font-body-md text-body-md text-primary-fixed mb-8 max-w-xl mx-auto">
        Dapatkan notifikasi langsung ke WhatsApp atau Email Anda untuk setiap kegiatan dan berita terbaru dari desa kami.
      </p>
      <div class="flex flex-col md:flex-row gap-4 justify-center max-w-lg mx-auto">
        <input 
          class="flex-1 px-6 py-4 rounded-lg bg-primary-container border-none text-on-primary placeholder-on-primary-container focus:ring-2 focus:ring-secondary focus:outline-none" 
          placeholder="Alamat Email Anda" 
          type="email"
        />
        <button class="px-8 py-4 bg-secondary text-white font-bold rounded-lg hover:brightness-110 transition-all">
          Berlangganan
        </button>
      </div>
    </div>
  </section>
</Layout>
