---
import Layout from "../../layouts/Layout.astro";
import { auth } from "../../lib/auth";

export const prerender = false;

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

if (!session) {
  return Astro.redirect("/login");
}

if (session.user.role !== "admin") {
  return Astro.redirect("/dashboard");
}
---

<Layout title="Kelola Surat - Admin Panel">
  <div class="min-h-screen px-gutter py-20">
    <div class="max-w-container-max mx-auto">
      <div class="bg-surface rounded-2xl shadow-lg p-8 border border-outline-variant mb-8">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-8">
          <div>
            <h1 class="font-headline-md text-headline-md font-bold text-primary mb-2">
              Kelola Surat Masuk
            </h1>
            <p class="text-on-surface-variant">Lihat dan kelola status surat yang dikirim warga</p>
          </div>
          <div class="flex gap-3">
            <a href="/admin" class="bg-on-surface-variant text-on-primary px-6 py-2.5 rounded-xl font-label-md hover:opacity-90 transition-all active:scale-95">
              Admin Panel
            </a>
            <a href="/admin/templates" class="bg-secondary text-on-secondary px-6 py-2.5 rounded-xl font-label-md hover:opacity-90 transition-all active:scale-95">
              Kelola Template
            </a>
          </div>
        </div>

        <!-- Status Filter Tabs -->
        <div class="flex flex-wrap gap-2 mb-6">
          <button onclick="filterLetters('all')" data-filter="all" class="filter-tab bg-primary text-on-primary px-4 py-2 rounded-full font-label-sm hover:opacity-90 transition-all font-bold">
            Semua
          </button>
          <button onclick="filterLetters('dikirim')" data-filter="dikirim" class="filter-tab bg-surface-container-high text-on-surface-variant px-4 py-2 rounded-full font-label-sm hover:opacity-90 transition-all font-bold">
            Dikirim
          </button>
          <button onclick="filterLetters('direview')" data-filter="direview" class="filter-tab bg-surface-container-high text-on-surface-variant px-4 py-2 rounded-full font-label-sm hover:opacity-90 transition-all font-bold">
            Direview
          </button>
          <button onclick="filterLetters('diterima')" data-filter="diterima" class="filter-tab bg-surface-container-high text-on-surface-variant px-4 py-2 rounded-full font-label-sm hover:opacity-90 transition-all font-bold">
            Diterima
          </button>
          <button onclick="filterLetters('ditolak')" data-filter="ditolak" class="filter-tab bg-surface-container-high text-on-surface-variant px-4 py-2 rounded-full font-label-sm hover:opacity-90 transition-all font-bold">
            Ditolak
          </button>
        </div>

        <!-- Letters List -->
        <div id="letters-list" class="flex flex-col gap-3">
          <p class="text-on-surface-variant text-body-md">Memuat surat...</p>
        </div>
      </div>

      <!-- Detail Panel -->
      <div id="detail-panel" class="hidden bg-surface rounded-2xl shadow-lg p-8 border border-outline-variant">
        <div class="flex items-center justify-between mb-6">
          <h2 class="font-headline-md text-headline-md font-bold text-primary">Detail Surat</h2>
          <button onclick="closeDetail()" class="text-on-surface-variant hover:text-primary transition-colors">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <div>
            <h3 class="font-label-md text-on-surface-variant mb-1">Pengirim</h3>
            <p id="detail-user" class="font-semibold text-on-surface"></p>
            <p id="detail-email" class="text-on-surface-variant text-sm"></p>
          </div>
          <div>
            <h3 class="font-label-md text-on-surface-variant mb-1">Template</h3>
            <p id="detail-template" class="font-semibold text-on-surface"></p>
          </div>
          <div>
            <h3 class="font-label-md text-on-surface-variant mb-1">Status</h3>
            <p id="detail-status" class="font-semibold"></p>
          </div>
          <div>
            <h3 class="font-label-md text-on-surface-variant mb-1">Tanggal Kirim</h3>
            <p id="detail-date" class="font-semibold text-on-surface"></p>
          </div>
        </div>

        <div id="detail-rejection" class="hidden mb-6 p-4 bg-error-container text-on-error-container rounded-xl">
          <h3 class="font-label-md font-semibold mb-1">Alasan Penolakan</h3>
          <p id="detail-rejection-text"></p>
        </div>

        <div class="flex flex-wrap gap-3 mb-6">
          <a id="detail-download" href="#" class="inline-flex items-center gap-2 bg-secondary text-on-secondary px-6 py-2.5 rounded-full font-label-md hover:opacity-90 transition-all font-bold">
            <span class="material-symbols-outlined text-[18px]">download</span> Unduh Surat
          </a>
        </div>

        <div class="border-t border-outline-variant pt-6">
          <h3 class="font-label-lg text-on-surface mb-4">Ubah Status</h3>
          <div class="flex flex-col gap-4">
            <div class="flex flex-wrap gap-3">
              <button onclick="updateStatus('direview')" class="bg-yellow-100 text-yellow-800 px-4 py-2 rounded-full font-label-sm hover:opacity-90 transition-all font-bold border border-yellow-300">
                Direview
              </button>
              <button onclick="updateStatus('diterima')" class="bg-green-100 text-green-800 px-4 py-2 rounded-full font-label-sm hover:opacity-90 transition-all font-bold border border-green-300">
                Diterima
              </button>
              <button onclick="showRejectForm()" class="bg-red-100 text-red-800 px-4 py-2 rounded-full font-label-sm hover:opacity-90 transition-all font-bold border border-red-300">
                Ditolak
              </button>
            </div>

            <div id="reject-form" class="hidden">
              <label for="reject-reason" class="block font-label-md text-on-surface mb-2">Alasan Penolakan *</label>
              <textarea
                id="reject-reason"
                rows="3"
                required
                class="w-full px-4 py-3 rounded-xl border border-outline bg-surface text-on-surface font-body-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all resize-none mb-3"
                placeholder="Jelaskan alasan penolakan..."
              ></textarea>
              <div class="flex gap-3">
                <button onclick="updateStatus('ditolak')" class="bg-error text-on-error px-6 py-2.5 rounded-full font-label-md hover:opacity-90 transition-all font-bold">
                  Konfirmasi Tolak
                </button>
                <button onclick="hideRejectForm()" class="bg-on-surface-variant text-on-primary px-6 py-2.5 rounded-full font-label-md hover:opacity-90 transition-all font-bold">
                  Batal
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const STATUS_LABELS: Record<string, string> = {
    dikirim: "Dikirim",
    direview: "Sedang Direview",
    diterima: "Diterima",
    ditolak: "Ditolak",
  };
  const STATUS_COLORS: Record<string, string> = {
    dikirim: "bg-blue-100 text-blue-800",
    direview: "bg-yellow-100 text-yellow-800",
    diterima: "bg-green-100 text-green-800",
    ditolak: "bg-red-100 text-red-800",
  };

  let currentFilter = "all";
  let currentLetterId: number | null = null;
  let allLetters: any[] = [];

  const listDiv = document.getElementById("letters-list") as HTMLDivElement;
  const detailPanel = document.getElementById("detail-panel") as HTMLDivElement;

  async function loadLetters(status?: string) {
    listDiv.innerHTML = '<p class="text-on-surface-variant text-body-md">Memuat surat...</p>';

    try {
      const url = status && status !== "all" ? `/api/letters?status=${status}` : "/api/letters";
      const res = await fetch(url);
      allLetters = await res.json();

      if (!allLetters.length) {
        listDiv.innerHTML = '<p class="text-on-surface-variant text-body-md">Tidak ada surat ditemukan.</p>';
        return;
      }

      renderLetters(allLetters);
    } catch {
      listDiv.innerHTML = '<p class="text-error text-body-md">Gagal memuat surat.</p>';
    }
  }

  function renderLetters(letters: any[]) {
    listDiv.innerHTML = letters
      .map(
        (l) => `
        <div class="flex items-center justify-between p-4 bg-background rounded-xl border border-outline-variant hover:shadow-sm transition-all cursor-pointer" onclick="openDetail(${l.id})">
          <div class="flex flex-col gap-1 min-w-0">
            <span class="font-semibold text-on-surface truncate">${l.userName} (${l.userEmail})</span>
            <span class="text-on-surface-variant text-sm">${l.templateTitle}</span>
            <span class="text-on-surface-variant text-xs">${new Date(l.createdAt).toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" })}</span>
          </div>
          <span class="px-3 py-1 rounded-full text-xs font-bold shrink-0 ml-4 ${STATUS_COLORS[l.status] || "bg-gray-100 text-gray-800"}">
            ${STATUS_LABELS[l.status] || l.status}
          </span>
        </div>
      `,
      )
      .join("");
  }

  (window as any).filterLetters = function (status: string) {
    currentFilter = status;
    document.querySelectorAll(".filter-tab").forEach((tab) => {
      const el = tab as HTMLElement;
      if (el.dataset.filter === status) {
        el.className = "filter-tab bg-primary text-on-primary px-4 py-2 rounded-full font-label-sm hover:opacity-90 transition-all font-bold";
      } else {
        el.className = "filter-tab bg-surface-container-high text-on-surface-variant px-4 py-2 rounded-full font-label-sm hover:opacity-90 transition-all font-bold";
      }
    });
    loadLetters(status);
  };

  (window as any).openDetail = async function (id: number) {
    currentLetterId = id;
    try {
      const res = await fetch(`/api/letters/${id}`);
      if (!res.ok) return;
      const letter = await res.json();

      document.getElementById("detail-user")!.textContent = letter.userName;
      document.getElementById("detail-email")!.textContent = letter.userEmail;
      document.getElementById("detail-template")!.textContent = letter.templateTitle;

      const statusEl = document.getElementById("detail-status")!;
      statusEl.textContent = STATUS_LABELS[letter.status] || letter.status;
      statusEl.className = `font-semibold px-3 py-1 rounded-full text-sm inline-block ${STATUS_COLORS[letter.status] || ""}`;

      document.getElementById("detail-date")!.textContent = new Date(letter.createdAt).toLocaleDateString("id-ID", {
        day: "numeric",
        month: "long",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      });

      const rejectDiv = document.getElementById("detail-rejection")!;
      if (letter.rejectionReason) {
        rejectDiv.classList.remove("hidden");
        document.getElementById("detail-rejection-text")!.textContent = letter.rejectionReason;
      } else {
        rejectDiv.classList.add("hidden");
      }

      document.getElementById("detail-download")!.href = `/api/letters/download/${letter.id}`;
      document.getElementById("reject-form")!.classList.add("hidden");

      detailPanel.classList.remove("hidden");
      detailPanel.scrollIntoView({ behavior: "smooth" });
    } catch {}
  };

  (window as any).closeDetail = function () {
    detailPanel.classList.add("hidden");
    currentLetterId = null;
  };

  (window as any).showRejectForm = function () {
    document.getElementById("reject-form")!.classList.remove("hidden");
  };

  (window as any).hideRejectForm = function () {
    document.getElementById("reject-form")!.classList.add("hidden");
  };

  (window as any).updateStatus = async function (status: string) {
    if (!currentLetterId) return;

    const body: any = { status };
    if (status === "ditolak") {
      const reason = (document.getElementById("reject-reason") as HTMLTextAreaElement).value.trim();
      if (!reason) {
        alert("Alasan penolakan wajib diisi.");
        return;
      }
      body.rejectionReason = reason;
    }

    try {
      const res = await fetch(`/api/letters/${currentLetterId}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });

      if (!res.ok) {
        const data = await res.json();
        alert(data.error || "Gagal mengubah status.");
        return;
      }

      loadLetters(currentFilter);
      (window as any).openDetail(currentLetterId);
    } catch {
      alert("Gagal mengubah status.");
    }
  };

  loadLetters();
</script>
