---
import Layout from "../../layouts/Layout.astro";
import { auth } from "../../lib/auth";

export const prerender = false;

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

if (!session) {
  return Astro.redirect("/login");
}

if (session.user.role !== "admin") {
  return Astro.redirect("/");
}
---

<Layout
  title="Pengaturan Situs - Admin Panel"
  activePage="admin-settings"
  session={session}
>
  <div class="min-h-screen px-gutter py-20">
    <div class="max-w-container-max mx-auto">
      <div
        class="bg-surface rounded-2xl shadow-lg p-8 border border-outline-variant mb-8"
      >
        <div
          class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-8"
        >
          <div>
            <h1
              class="font-headline-md text-headline-md font-bold text-primary mb-2"
            >
              Pengaturan Situs
            </h1>
            <p class="text-on-surface-variant">
              Kelola konten yang ditampilkan di halaman utama
            </p>
          </div>
        </div>

        <!-- Status messages -->
        <div
          id="save-success"
          class="hidden bg-green-50 text-green-700 border border-green-200 rounded-xl p-4 mb-6"
        >
          Pengaturan berhasil disimpan!
        </div>
        <div
          id="save-error"
          class="hidden bg-red-50 text-red-700 border border-red-200 rounded-xl p-4 mb-6"
        >
        </div>

        <!-- Hero Section -->
        <div
          class="bg-background rounded-xl p-6 border border-outline-variant mb-8"
        >
          <h3
            class="font-label-lg text-on-surface mb-4 flex items-center gap-2"
          >
            <span class="material-symbols-outlined text-primary text-xl"
              >home</span
            >
            Landing
          </h3>
          <div class="flex flex-col gap-4">
            <div>
              <label
                for="hero-title"
                class="block text-on-surface font-label-md mb-2"
                >Teks Utama*</label
              >
              <input
                type="text"
                id="hero-title"
                class="w-full px-4 py-3 rounded-xl border border-outline bg-surface text-on-surface font-body-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
              />
            </div>
            <div>
              <label
                for="hero-desc"
                class="block text-on-surface font-label-md mb-2"
                >Teks Deskripsi*</label
              >
              <textarea
                id="hero-desc"
                rows="3"
                class="w-full px-4 py-3 rounded-xl border border-outline bg-surface text-on-surface font-body-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all resize-none"
              ></textarea>
            </div>
            <div>
              <label class="block text-on-surface font-label-md mb-2"
                >Gambar Hero</label
              >
              <div class="flex items-start gap-4">
                <div class="flex-1">
                  <input
                    type="file"
                    id="hero-image-file"
                    accept="image/jpeg,image/png,image/webp,image/gif"
                    class="w-full px-4 py-3 rounded-xl border border-outline bg-surface text-on-surface font-body-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-bold file:bg-primary-container file:text-on-primary-container hover:file:opacity-80"
                  />
                  <p class="text-on-surface-variant text-sm mt-1">
                    JPEG, PNG, WebP, atau GIF. Maks 5MB.
                  </p>
                </div>
                <div
                  id="hero-image-preview"
                  class="w-32 h-24 rounded-xl overflow-hidden border border-outline-variant bg-surface-container-low shrink-0"
                >
                  <img
                    id="hero-image-preview-img"
                    class="w-full h-full object-cover hidden"
                    alt="Preview"
                  />
                  <div
                    id="hero-image-placeholder"
                    class="w-full h-full flex items-center justify-center text-on-surface-variant"
                  >
                    <span class="material-symbols-outlined text-3xl">image</span
                    >
                  </div>
                </div>
              </div>
              <input type="hidden" id="hero-image-url" />
            </div>
          </div>
        </div>

        <!-- Village Head Welcome Section -->
        <div
          class="bg-background rounded-xl p-6 border border-outline-variant mb-8"
        >
          <h3
            class="font-label-lg text-on-surface mb-4 flex items-center gap-2"
          >
            <span class="material-symbols-outlined text-primary text-xl"
              >person</span
            >
            Sambutan Kepala Desa
          </h3>
          <div class="flex flex-col gap-4">
            <div>
              <label
                for="vhw-sambutan"
                class="block text-on-surface font-label-md mb-2"
                >Sambutan *</label
              >
              <textarea
                id="vhw-sambutan"
                rows="4"
                class="w-full px-4 py-3 rounded-xl border border-outline bg-surface text-on-surface font-body-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all resize-none"
              ></textarea>
            </div>
            <div>
              <label
                for="vhw-name"
                class="block text-on-surface font-label-md mb-2"
                >Nama Kepala Desa *</label
              >
              <input
                type="text"
                id="vhw-name"
                class="w-full px-4 py-3 rounded-xl border border-outline bg-surface text-on-surface font-body-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
              />
            </div>
            <div>
              <label class="block text-on-surface font-label-md mb-2"
                >Foto Kepala Desa</label
              >
              <div class="flex items-start gap-4">
                <div class="flex-1">
                  <input
                    type="file"
                    id="vhw-image-file"
                    accept="image/jpeg,image/png,image/webp,image/gif"
                    class="w-full px-4 py-3 rounded-xl border border-outline bg-surface text-on-surface font-body-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-bold file:bg-primary-container file:text-on-primary-container hover:file:opacity-80"
                  />
                  <p class="text-on-surface-variant text-sm mt-1">
                    JPEG, PNG, WebP, atau GIF. Maks 5MB.
                  </p>
                </div>
                <div
                  id="vhw-image-preview"
                  class="w-24 h-24 rounded-xl overflow-hidden border border-outline-variant bg-surface-container-low shrink-0"
                >
                  <img
                    id="vhw-image-preview-img"
                    class="w-full h-full object-cover hidden"
                    alt="Preview"
                  />
                  <div
                    id="vhw-image-placeholder"
                    class="w-full h-full flex items-center justify-center text-on-surface-variant"
                  >
                    <span class="material-symbols-outlined text-3xl">image</span
                    >
                  </div>
                </div>
              </div>
              <input type="hidden" id="vhw-image-url" />
            </div>
          </div>
        </div>

        <!-- Vision & Missions Section -->
        <div
          class="bg-background rounded-xl p-6 border border-outline-variant mb-8"
        >
          <h3
            class="font-label-lg text-on-surface mb-4 flex items-center gap-2"
          >
            <span class="material-symbols-outlined text-primary text-xl"
              >visibility</span
            >
            Visi &amp; Misi
          </h3>
          <div class="flex flex-col gap-4">
            <div>
              <label
                for="vm-vision"
                class="block text-on-surface font-label-md mb-2">Visi *</label
              >
              <textarea
                id="vm-vision"
                rows="3"
                class="w-full px-4 py-3 rounded-xl border border-outline bg-surface text-on-surface font-body-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all resize-none"
              ></textarea>
            </div>

            <div>
              <label class="block text-on-surface font-label-md mb-2"
                >Misi</label
              >
              <div id="missions-list" class="flex flex-col gap-3">
                <p class="text-on-surface-variant text-body-md">
                  Memuat misi...
                </p>
              </div>
              <button
                type="button"
                id="add-mission-btn"
                class="mt-4 bg-primary-container text-on-primary-container px-4 py-2 rounded-xl font-label-md hover:opacity-90 transition-all active:scale-95 flex items-center gap-2"
              >
                <span class="material-symbols-outlined text-xl">add</span>
                Tambah Misi
              </button>
            </div>
          </div>
        </div>

        <!-- Save Button -->
        <div class="flex justify-end">
          <button
            type="button"
            id="save-btn"
            class="bg-primary text-on-primary px-8 py-3 rounded-xl font-label-md hover:opacity-90 transition-all active:scale-95 font-bold disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Simpan Semua
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const heroTitle = document.getElementById("hero-title") as HTMLInputElement;
  const heroDesc = document.getElementById("hero-desc") as HTMLTextAreaElement;
  const heroImageFile = document.getElementById(
    "hero-image-file",
  ) as HTMLInputElement;
  const heroImageUrl = document.getElementById(
    "hero-image-url",
  ) as HTMLInputElement;
  const heroImagePreviewImg = document.getElementById(
    "hero-image-preview-img",
  ) as HTMLImageElement;
  const heroImagePlaceholder = document.getElementById(
    "hero-image-placeholder",
  ) as HTMLDivElement;
  const vhwSambutan = document.getElementById(
    "vhw-sambutan",
  ) as HTMLTextAreaElement;
  const vhwName = document.getElementById("vhw-name") as HTMLInputElement;
  const vhwImageFile = document.getElementById(
    "vhw-image-file",
  ) as HTMLInputElement;
  const vhwImageUrl = document.getElementById(
    "vhw-image-url",
  ) as HTMLInputElement;
  const vhwImagePreviewImg = document.getElementById(
    "vhw-image-preview-img",
  ) as HTMLImageElement;
  const vhwImagePlaceholder = document.getElementById(
    "vhw-image-placeholder",
  ) as HTMLDivElement;
  const vmVision = document.getElementById("vm-vision") as HTMLTextAreaElement;
  const missionsList = document.getElementById(
    "missions-list",
  ) as HTMLDivElement;
  const addMissionBtn = document.getElementById(
    "add-mission-btn",
  ) as HTMLButtonElement;
  const saveBtn = document.getElementById("save-btn") as HTMLButtonElement;
  const saveSuccess = document.getElementById("save-success") as HTMLDivElement;
  const saveError = document.getElementById("save-error") as HTMLDivElement;

  let missions: { title: string; description: string }[] = [];

  function showSuccess() {
    saveSuccess.classList.remove("hidden");
    saveError.classList.add("hidden");
    setTimeout(() => saveSuccess.classList.add("hidden"), 3000);
  }

  function showError(msg: string) {
    saveError.textContent = msg;
    saveError.classList.remove("hidden");
    saveSuccess.classList.add("hidden");
  }

  function renderMissions() {
    if (missions.length === 0) {
      missionsList.innerHTML =
        '<p class="text-on-surface-variant text-body-md">Belum ada misi.</p>';
      return;
    }

    missionsList.innerHTML = missions
      .map(
        (m, i) => `
        <div class="flex gap-3 items-start p-4 bg-surface rounded-xl border border-outline-variant">
          <div class="shrink-0 w-8 h-8 rounded-full border border-outline flex items-center justify-center font-bold text-sm text-on-surface-variant">
            ${i + 1}
          </div>
          <div class="flex-1 flex flex-col gap-2">
            <input
              type="text"
              value="${m.title.replace(/"/g, "&quot;")}"
              data-index="${i}"
              data-field="title"
              class="mission-input w-full px-3 py-2 rounded-lg border border-outline bg-background text-on-surface font-body-md text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
              placeholder="Judul misi"
            />
            <textarea
              data-index="${i}"
              data-field="description"
              class="mission-input w-full px-3 py-2 rounded-lg border border-outline bg-background text-on-surface font-body-md text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all resize-none"
              rows="2"
              placeholder="Deskripsi misi"
            >${m.description.replace(/</g, "&lt;")}</textarea>
          </div>
          <div class="flex flex-col gap-1 shrink-0">
            <button
              type="button"
              onclick="moveMission(${i}, -1)"
              class="p-1 text-on-surface-variant hover:text-primary transition-colors ${i === 0 ? "opacity-30 pointer-events-none" : ""}"
              title="Pindah ke atas"
            >
              <span class="material-symbols-outlined text-lg">arrow_upward</span>
            </button>
            <button
              type="button"
              onclick="moveMission(${i}, 1)"
              class="p-1 text-on-surface-variant hover:text-primary transition-colors ${i === missions.length - 1 ? "opacity-30 pointer-events-none" : ""}"
              title="Pindah ke bawah"
            >
              <span class="material-symbols-outlined text-lg">arrow_downward</span>
            </button>
            <button
              type="button"
              onclick="removeMission(${i})"
              class="p-1 text-error hover:text-error transition-colors"
              title="Hapus"
            >
              <span class="material-symbols-outlined text-lg">delete</span>
            </button>
          </div>
        </div>
      `,
      )
      .join("");

    // Attach input listeners
    missionsList.querySelectorAll(".mission-input").forEach((el) => {
      el.addEventListener("input", (e) => {
        const target = e.target as HTMLInputElement | HTMLTextAreaElement;
        const idx = parseInt(target.dataset.index!);
        const field = target.dataset.field as "title" | "description";
        missions[idx][field] = target.value;
      });
    });
  }

  (window as any).moveMission = function (index: number, direction: number) {
    const newIndex = index + direction;
    if (newIndex < 0 || newIndex >= missions.length) return;
    const temp = missions[index];
    missions[index] = missions[newIndex];
    missions[newIndex] = temp;
    renderMissions();
  };

  (window as any).removeMission = function (index: number) {
    missions.splice(index, 1);
    renderMissions();
  };

  addMissionBtn.addEventListener("click", () => {
    missions.push({ title: "", description: "" });
    renderMissions();
    // Focus the new title input
    const inputs = missionsList.querySelectorAll('[data-field="title"]');
    const last = inputs[inputs.length - 1] as HTMLInputElement;
    if (last) last.focus();
  });

  // Image upload — hero
  heroImageFile.addEventListener("change", async () => {
    const file = heroImageFile.files?.[0];
    if (!file) return;

    const formData = new FormData();
    formData.append("file", file);
    formData.append("key", "hero_image");

    try {
      const res = await fetch("/api/settings/upload-image", {
        method: "POST",
        body: formData,
      });
      const data = await res.json();

      if (!res.ok) {
        alert(data.error || "Gagal mengunggah gambar.");
        return;
      }

      const previewUrl = URL.createObjectURL(file);
      heroImageUrl.value = data.url;
      heroImagePreviewImg.src = previewUrl;
      heroImagePreviewImg.classList.remove("hidden");
      heroImagePlaceholder.classList.add("hidden");
      heroImageFile.value = "";
    } catch {
      alert("Gagal mengunggah gambar.");
    }
  });

  // Image upload — village head
  vhwImageFile.addEventListener("change", async () => {
    const file = vhwImageFile.files?.[0];
    if (!file) return;

    const formData = new FormData();
    formData.append("file", file);

    try {
      const res = await fetch("/api/settings/upload-image", {
        method: "POST",
        body: formData,
      });
      const data = await res.json();

      if (!res.ok) {
        alert(data.error || "Gagal mengunggah gambar.");
        return;
      }

      const previewUrl = URL.createObjectURL(file);
      vhwImageUrl.value = data.url;
      vhwImagePreviewImg.src = previewUrl;
      vhwImagePreviewImg.classList.remove("hidden");
      vhwImagePlaceholder.classList.add("hidden");
      vhwImageFile.value = "";
    } catch {
      alert("Gagal mengunggah gambar.");
    }
  });

  // Load current settings
  async function loadSettings() {
    try {
      const res = await fetch("/api/settings");
      const data = await res.json();

      heroTitle.value = data.settings.hero_title || "";
      heroDesc.value = data.settings.hero_desc || "";
      vhwSambutan.value = data.settings.vhw_sambutan || "";
      vhwName.value = data.settings.vhw_kepalaDesaName || "";
      vmVision.value = data.settings.vm_vision || "";

      if (data.settings.hero_image) {
        heroImageUrl.value = data.settings.hero_image;
        heroImagePreviewImg.src = `/api/settings/image/hero_image?v=${encodeURIComponent(data.settings.hero_image)}`;
        heroImagePreviewImg.classList.remove("hidden");
        heroImagePlaceholder.classList.add("hidden");
      }

      if (data.settings.vhw_kepalaDesaImage) {
        vhwImageUrl.value = data.settings.vhw_kepalaDesaImage;
        vhwImagePreviewImg.src = `/api/settings/image/vhw_kepalaDesaImage?v=${encodeURIComponent(data.settings.vhw_kepalaDesaImage)}`;
        vhwImagePreviewImg.classList.remove("hidden");
        vhwImagePlaceholder.classList.add("hidden");
      }

      missions = data.missions.map((m: any) => ({
        title: m.title,
        description: m.description,
      }));
      renderMissions();
    } catch {
      showError("Gagal memuat pengaturan.");
    }
  }

  // Save all settings
  saveBtn.addEventListener("click", async () => {
    saveBtn.disabled = true;
    saveBtn.textContent = "Menyimpan...";

    const settings: Record<string, string> = {
      hero_title: heroTitle.value.trim(),
      hero_desc: heroDesc.value.trim(),
      hero_image: heroImageUrl.value,
      vhw_sambutan: vhwSambutan.value.trim(),
      vhw_kepalaDesaName: vhwName.value.trim(),
      vhw_kepalaDesaImage: vhwImageUrl.value,
      vm_vision: vmVision.value.trim(),
    };

    try {
      // Save scalar settings
      const res = await fetch("/api/settings", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ settings }),
      });

      if (!res.ok) {
        const data = await res.json();
        showError(data.error || "Gagal menyimpan pengaturan.");
        saveBtn.disabled = false;
        saveBtn.textContent = "Simpan Semua";
        return;
      }

      // Save missions
      const missionsRes = await fetch("/api/settings/missions", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ missions }),
      });

      if (!missionsRes.ok) {
        const data = await missionsRes.json();
        showError(data.error || "Gagal menyimpan misi.");
        saveBtn.disabled = false;
        saveBtn.textContent = "Simpan Semua";
        return;
      }

      showSuccess();
    } catch {
      showError("Terjadi kesalahan. Coba lagi nanti.");
    }

    saveBtn.disabled = false;
    saveBtn.textContent = "Simpan Semua";
  });

  loadSettings();
</script>
