// import InfoBento from "../components/home/infoBento.astro";
import VisionMission from "../components/home/visionMission.astro";

export const prerender = false;

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

// NOTE: control panel
const hero_title = "Membangun Masa Depan Berbasis Nilai Tradisi.";
const hero_desc =
  "Kami berdedikasi untuk menciptakan lingkungan yang mandiri, inovatif, dan berkelanjutan bagi seluruh warga dan generasi mendatang.";

