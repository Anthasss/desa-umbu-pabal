---
import Layout from "../../layouts/Layout.astro";
import { auth } from "../../lib/auth";

export const prerender = false;

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});
---

<Layout title="Pembangunan Irigasi Baru Selesai Tepat Waktu - Desa Umbu Pabal" activePage="berita" session={session}>
  <div class="max-w-container-max mx-auto px-gutter py-section-padding-mobile md:py-section-padding-desktop">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
      <!-- Article Content Area -->
      <article class="lg:col-span-8 space-y-10">
        <!-- Header Section -->
        <header class="space-y-6">
          <div class="flex items-center gap-4">
            <span class="bg-primary-container text-on-primary-container px-4 py-1 rounded-full font-label-md text-label-md uppercase tracking-wide font-bold">Infrastruktur</span>
            <span class="text-on-surface-variant font-label-md text-label-md flex items-center gap-1">
              <span class="material-symbols-outlined text-[18px]">calendar_today</span>
              20 Mei 2024
            </span>
          </div>
          <h1 class="font-headline-xl text-headline-xl-mobile md:text-headline-xl text-primary leading-tight font-bold text-3xl md:text-4xl">
            Pembangunan Irigasi Baru Selesai Tepat Waktu
          </h1>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center overflow-hidden border border-outline-variant">
              <span class="material-symbols-outlined text-primary">person</span>
            </div>
            <span class="font-label-md text-label-md text-on-surface">Ditulis oleh <span class="text-primary font-bold">Admin Desa</span></span>
          </div>
        </header>

        <!-- Featured Image -->
        <div class="relative rounded-xl overflow-hidden shadow-sm aspect-[1.37] lg:aspect-video">
          <img 
            alt="Rice fields in a tropical village" 
            class="w-full h-full object-cover" 
            src="https://lh3.googleusercontent.com/aida/ADBb0uiXcNYSHNNFwKPd8Bh18jtZm5LGdFMgTRMFx615eS2-tkgAhI-3DXa9atimzZeRt557SiTOGd8EcD9rj4XQfmkkrk_HLKWB5v858s-wQ08_B0kqydVHhdyrfX4oX7OSBLognS7mipLxuPEjB_Fw0ps2cKK9mxN3p9GJtdkV9H3MLv8hQImPAyCB1S1jEAAiazTKA8q7Z0fw8q_qwgz5u51lw82AOxZdGvrLtaT6m7DVat4SVNz-nooKOmc"
          />
        </div>

        <!-- Article Body -->
        <div class="prose prose-lg max-w-none text-on-surface-variant font-body-md text-body-md leading-relaxed space-y-6">
          <p class="font-body-lg text-body-lg text-on-surface font-semibold text-lg">
            Pemerintah Desa dengan bangga mengumumkan penyelesaian proyek pembangunan irigasi strategis di wilayah Dusun Utara. Proyek ini rampung sesuai jadwal yang ditetapkan, menandai tonggak penting dalam upaya modernisasi pertanian desa.
          </p>
          <p>
            Saluran irigasi baru ini membentang sepanjang wilayah pertanian utama dan dirancang untuk mencakup sedikitnya 50 hektar lahan persawahan yang sebelumnya bergantung sepenuhnya pada curah hujan. Dengan adanya sistem aliran air yang stabil, para petani kini dapat mengatur siklus tanam dengan lebih presisi tanpa khawatir akan kendala kekeringan di musim kemarau.
          </p>
          <h2 class="font-headline-lg text-headline-md md:text-headline-lg text-primary pt-6 border-l-4 border-secondary pl-6 text-xl font-bold">
            Meningkatkan Produktivitas Pertanian
          </h2>
          <p>
            Penyelesaian proyek ini diharapkan akan meningkatkan produktivitas pertanian lokal secara signifikan. Berdasarkan estimasi teknis, efisiensi distribusi air akan meningkat hingga 40%, yang berdampak langsung pada kualitas gabah yang dihasilkan. "Ini adalah investasi jangka panjang untuk kesejahteraan warga kami," ujar perwakilan tim teknis pembangunan.
          </p>
          <p>
            Selain manfaat fungsional, struktur irigasi dibangun dengan material berkualitas tinggi yang ramah lingkungan, memastikan ketahanan infrastruktur selama puluhan tahun ke depan dengan perawatan yang minimal.
          </p>
          <!-- Quote Block -->
          <blockquote class="bg-surface-container-low border-l-4 border-primary p-8 rounded-r-xl italic text-on-primary-container my-6">
            "Pembangunan ini bukan sekadar tentang semen dan air, melainkan tentang masa depan ketahanan pangan desa kita. Kami berkomitmen untuk terus menjaga tradisi agraris sambil mengadopsi teknologi yang efisien."
          </blockquote>
          <h2 class="font-headline-lg text-headline-md md:text-headline-lg text-primary pt-6 text-xl font-bold">
            Langkah Selanjutnya
          </h2>
          <p>
            Setelah peresmian ini, pemerintah desa akan mengadakan pelatihan bagi kelompok tani (Gapoktan) mengenai manajemen pembagian air yang adil dan pemeliharaan rutin saluran. Sinergi antara infrastruktur yang baik dan sumber daya manusia yang terampil diharapkan dapat membawa desa menuju kemandirian pangan yang sejati.
          </p>
        </div>

        <!-- Tags & Social Share -->
        <div class="pt-10 border-t border-outline-variant flex flex-col md:flex-row justify-between gap-6">
          <div class="flex flex-wrap gap-2">
            <span class="px-4 py-2 bg-surface-container rounded-lg text-label-md font-label-md text-on-surface-variant font-medium">#Pertanian</span>
            <span class="px-4 py-2 bg-surface-container rounded-lg text-label-md font-label-md text-on-surface-variant font-medium">#DusunUtara</span>
            <span class="px-4 py-2 bg-surface-container rounded-lg text-label-md font-label-md text-on-surface-variant font-medium">#DesaDigital</span>
          </div>
          <div class="flex items-center gap-4">
            <button class="w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center hover:bg-primary hover:text-on-primary transition-all">
              <span class="material-symbols-outlined text-[20px]">share</span>
            </button>
          </div>
        </div>
      </article>

      <!-- Sidebar (Sticky) -->
      <aside class="lg:col-span-4 space-y-8">
        <div class="sticky top-28 space-y-8">
          <!-- Related News Card -->
          <section class="bg-surface-container-lowest p-gutter rounded-xl border border-outline-variant shadow-sm">
            <h3 class="font-headline-md text-headline-md text-primary mb-6 font-bold text-lg border-b border-outline-variant pb-2">
              Berita Terkait
            </h3>
            <div class="space-y-6">
              <!-- Related Item 1 -->
              <span class="group flex gap-4 items-start cursor-pointer">
                <div class="w-20 h-20 rounded-lg overflow-hidden flex-shrink-0 bg-surface-container-highest flex items-center justify-center text-outline">
                  <span class="material-symbols-outlined">image</span>
                </div>
                <div class="space-y-1">
                  <h4 class="font-label-md text-label-md text-on-surface group-hover:text-primary transition-colors font-bold text-sm">
                    Panen Raya Padi Organik di Sektor Selatan
                  </h4>
                  <p class="text-[12px] text-on-surface-variant">15 Mei 2024</p>
                </div>
              </span>
              <!-- Related Item 2 -->
              <span class="group flex gap-4 items-start cursor-pointer">
                <div class="w-20 h-20 rounded-lg overflow-hidden flex-shrink-0 bg-surface-container-highest flex items-center justify-center text-outline">
                  <span class="material-symbols-outlined">image</span>
                </div>
                <div class="space-y-1">
                  <h4 class="font-label-md text-label-md text-on-surface group-hover:text-primary transition-colors font-bold text-sm">
                    Pelatihan UMKM: Digitalisasi Pemasaran
                  </h4>
                  <p class="text-[12px] text-on-surface-variant">10 Mei 2024</p>
                </div>
              </span>
              <!-- Related Item 3 -->
              <span class="group flex gap-4 items-start cursor-pointer">
                <div class="w-20 h-20 rounded-lg overflow-hidden flex-shrink-0 bg-surface-container-highest flex items-center justify-center text-outline">
                  <span class="material-symbols-outlined">image</span>
                </div>
                <div class="space-y-1">
                  <h4 class="font-label-md text-label-md text-on-surface group-hover:text-primary transition-colors font-bold text-sm">
                    Rapat Desa: Anggaran Tahun 2025
                  </h4>
                  <p class="text-[12px] text-on-surface-variant">05 Mei 2024</p>
                </div>
              </span>
            </div>
            <a href="/berita" class="w-full block text-center mt-8 py-3 border border-primary text-primary font-label-md text-label-md rounded-lg hover:bg-primary hover:text-white transition-all font-bold">
              Lihat Semua Berita
            </a>
          </section>
        </div>
      </aside>
    </div>
  </div>
</Layout>
