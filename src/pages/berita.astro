---
import Layout from "../layouts/Layout.astro";
import { auth } from "../lib/auth";
import Hero from "../components/berita/hero.astro";
import { categoryStyles, categories, newsItems } from "../data/berita";

export const prerender = false;

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

const newsItemsDouble = [...newsItems, ...newsItems];
---

<Layout title="Berita Desa - Desa Umbu Pabal" activePage="berita" session={session}>
  <Hero />
  <!-- Search + Category Filter -->
  <div class="bg-surface-container-low py-4 mb-8 px-6 sticky top-20 z-40">
    <div
      class="max-w-[1200px] mx-auto flex flex-col sm:flex-row gap-4 sm:items-center justify-between"
    >
      <div class="relative flex-1 sm:max-w-xs">
        <span
          class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px] pointer-events-none"
        >
          search
        </span>
        <input
          id="search-input"
          type="text"
          placeholder="Cari berita..."
          class="w-full pl-10 pr-4 py-2 rounded-full bg-surface border border-outline-variant text-on-surface font-body-md text-sm focus:outline-none focus:ring-2 focus:ring-primary"
        />
      </div>
      <div class="flex gap-4 overflow-x-auto no-scrollbar">
        {
          categories.map((cat) => (
            <button
              class="filter-btn px-6 py-2 rounded-full font-label-md text-label-md whitespace-nowrap transition-colors"
              class:list={[
                cat === "Semua"
                  ? "bg-primary text-on-primary"
                  : "bg-surface text-on-surface-variant border border-outline-variant hover:bg-primary-fixed hover:text-on-primary-fixed",
              ]}
              data-category={cat === "Semua" ? "all" : cat}
            >
              {cat}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <!-- News Grid -->
  <section class="max-w-[1200px] mx-auto px-6 py-section-padding-desktop pt-0">
    <div
      id="news-grid"
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6"
    >
    </div>

    <!-- Sentinel for infinite scroll -->
    <div
      id="scroll-sentinel"
      class="h-12 flex items-center justify-center mt-4"
    >
      <div
        id="loading-indicator"
        class="hidden flex-col items-center justify-center gap-2 py-4"
      >
        <div
          class="w-8 h-8 rounded-full border-4 border-outline-variant border-t-primary animate-spin"
        >
        </div>
        <span class="text-on-surface-variant font-body-md text-sm"
          >Memuat berita</span
        >
      </div>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ newsItems: newsItemsDouble, categoryStyles }}>
  const PAGE_SIZE = 9;
  let currentPage = 0;
  let activeCategory = "all";
  let searchQuery = "";
  let isLoading = false;

  const grid = document.getElementById("news-grid");
  const sentinel = document.getElementById("scroll-sentinel");
  const loadingIndicator = document.getElementById("loading-indicator");
  const searchInput = document.getElementById("search-input");

  function getFilteredItems() {
    let result = newsItems;
    if (activeCategory !== "all") {
      result = result.filter((item) => item.category === activeCategory);
    }
    if (searchQuery.trim() !== "") {
      const q = searchQuery.trim().toLowerCase();
      result = result.filter((item) => item.title.toLowerCase().includes(q));
    }
    return result;
  }

  function createCard(item) {
    const card = document.createElement("div");
    card.className =
      "news-card bg-surface-container-lowest rounded-xl border border-outline-variant overflow-hidden group hover:shadow-lg transition-all duration-300";
    card.dataset.item = item.category;

    const badgeClass = categoryStyles[item.category] || "";

    card.innerHTML = `
      <div class="h-56 overflow-hidden relative">
        <img
          alt="${item.title}"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          src="${item.image}"
        />
        <div class="absolute top-4 left-4">
          <span class="backdrop-blur-md text-[12px] font-bold px-3 py-1 rounded uppercase tracking-wider ${badgeClass}">
            ${item.category}
          </span>
        </div>
      </div>
      <div class="p-6">
        <span class="text-on-surface-variant text-label-md block mb-2">${item.date}</span>
        <a href="/berita/${item.slug}">
          <h3 class="font-headline-md text-headline-md text-on-surface mb-3 group-hover:text-secondary transition-colors font-bold text-lg leading-snug">
            ${item.title}
          </h3>
        </a>
        <p class="text-on-surface-variant text-body-md mb-6 line-clamp-3">
          ${item.excerpt}
        </p>
        <a class="inline-flex items-center gap-2 text-secondary font-label-md group/link font-bold hover:underline" href="/berita/${item.slug}">
          Selengkapnya
          <span class="material-symbols-outlined text-[18px] group-hover/link:translate-x-1 transition-transform">
            arrow_forward
          </span>
        </a>
      </div>
    `;
    return card;
  }

  function loadNextPage() {
    const filtered = getFilteredItems();
    const start = currentPage * PAGE_SIZE;
    const end = start + PAGE_SIZE;
    const slice = filtered.slice(start, end);

    if (slice.length === 0) {
      observer.disconnect();
      loadingIndicator.classList.add("hidden");
      loadingIndicator.classList.remove("flex");
      return;
    }

    isLoading = true;
    loadingIndicator.classList.remove("hidden");
    loadingIndicator.classList.add("flex");

    // Simulate async fetch delay
    setTimeout(() => {
      slice.forEach((item) => grid.appendChild(createCard(item)));
      currentPage++;
      isLoading = false;
      loadingIndicator.classList.add("hidden");
      loadingIndicator.classList.remove("flex");

      if (currentPage * PAGE_SIZE >= filtered.length) {
        observer.disconnect();
      }
    }, 600);
  }

  function resetGallery() {
    currentPage = 0;
    grid.innerHTML = "";
    observer.observe(sentinel);
    loadNextPage();
  }

  // Infinite scroll observer
  const observer = new IntersectionObserver(
    (entries) => {
      if (entries[0].isIntersecting && !isLoading) {
        loadNextPage();
      }
    },
    { rootMargin: "200px" },
  );

  // Filter buttons
  document.querySelectorAll(".filter-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      activeCategory = btn.dataset.category;

      document.querySelectorAll(".filter-btn").forEach((b) => {
        b.classList.remove("bg-primary", "text-on-primary");
        b.classList.add(
          "bg-surface",
          "text-on-surface-variant",
          "border",
          "border-outline-variant",
        );
      });
      btn.classList.remove(
        "bg-surface",
        "text-on-surface-variant",
        "border",
        "border-outline-variant",
      );
      btn.classList.add("bg-primary", "text-on-primary");

      resetGallery();
    });
  });

  // Search input (debounced)
  let searchDebounceTimer;
  searchInput.addEventListener("input", (e) => {
    clearTimeout(searchDebounceTimer);
    const value = e.target.value;
    searchDebounceTimer = setTimeout(() => {
      searchQuery = value;
      resetGallery();
    }, 300);
  });

  // Initial load
  observer.observe(sentinel);
  loadNextPage();
</script>
