---
import Layout from "../layouts/Layout.astro";
import { auth } from "../lib/auth";

export const prerender = false;

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});
---

<Layout title="Potensi &amp; Ekonomi - Desa Umbu Pabal" activePage="ekonomi" session={session}>
  <!-- Hero Section -->
  <section class="relative h-[614px] flex items-center overflow-hidden">
    <img 
      alt="Village Economy Hero" 
      class="absolute inset-0 w-full h-full object-cover" 
      src="https://lh3.googleusercontent.com/aida-public/AB6AXuDnme8SDZy1OvJqpr4rhGbCsB6uTmpvLe2av7Wk2i07V-tPzVizKpgpqa-jSVOa-oNHZjYUDHIKHzlKrP7mE6EFr9OuzeyhOsG_YxNHz96ZxaM8AJQbLLWj1pvh3Bj6uQ4OPtzEbYlqLKIUO7b80db8YzcFxGe9JNA0niGJUXNVfPc6Wf5seo_mp9rA3gqp_BMVGefsvvC-Ph7mN05WG91Akcnj5dSEECvkDAoWu2tmN2FdGqBSn97fMMke_FuSTPq25ToGT_kGkT0"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-primary/80 to-transparent"></div>
    <div class="relative max-w-container-max mx-auto px-gutter w-full">
      <div class="max-w-2xl text-on-primary">
        <span class="inline-block bg-secondary-container text-on-secondary-container px-4 py-1 rounded-full text-label-md font-label-md mb-4 font-bold">Potensi &amp; Ekonomi</span>
        <h1 class="font-headline-xl text-headline-xl mb-6 leading-tight">Menumbuhkan Kekuatan Lokal untuk Masa Depan Berkelanjutan.</h1>
        <p class="font-body-lg text-body-lg text-primary-fixed mb-8">Temukan bagaimana Desa Umbu Pabal memadukan kearifan lokal dengan inovasi modern untuk mendorong pertumbuhan ekonomi warga.</p>
      </div>
    </div>
  </section>

  <!-- Main Sectors Bento Grid -->
  <section class="py-section-padding-desktop max-w-container-max mx-auto px-gutter">
    <div class="mb-12">
      <h2 class="font-headline-lg text-headline-lg text-primary mb-2">Pilar Ekonomi</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant">Sektor strategis yang mendorong kemandirian dan pertumbuhan desa kami.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
      <!-- Agriculture (Large) -->
      <div class="md:col-span-8 group relative overflow-hidden rounded-xl h-[400px]">
        <img 
          alt="Modern Agriculture" 
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuAnCdzWoyipAcZ4RZJFwEMBxfdCiVJ6uyzr2kuP9XcwlED2CePQT-b7bLgLUuae0mn4zSTgSEDtV-ROIhr8JXx9z4xOTyDKsjIbJU-FyI3NEG65KQYm2O-DMAYxLz5so3OnaKoDMZoPsg30Dnm4838L2yJpJ_GEqEnC6H8EFxk2d88-c9DNZBYjNynVbiPdkCU0c5yM4BF1BumhBt9UCFsi1ZKU_zu_LFBN7Yc6nwTDwtJmLc4ZMhqLkQYhIFqhjg1gBpXoEgepWE4"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-8 text-white">
          <div class="flex items-center gap-2 mb-2">
            <span class="material-symbols-outlined text-green-400">eco</span>
            <span class="font-label-md text-label-md uppercase tracking-wider text-green-400 font-bold">Sektor Utama</span>
          </div>
          <h3 class="font-headline-md text-headline-md mb-2 text-2xl font-bold">Smart Agriculture</h3>
          <p class="font-body-md text-body-md opacity-90 max-w-lg">Mengintegrasikan IoT dan metode organik untuk memaksimalkan hasil panen sambil melestarikan tanah leluhur.</p>
        </div>
      </div>
      <!-- Fishing (Tall) -->
      <div class="md:col-span-4 group relative overflow-hidden rounded-xl h-[400px]">
        <img 
          alt="Fishery Sector" 
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuBrMA5eNmu8KrlJV19BQJ86KVLiL8ti0Gbdaf4k-Gao01oLTgABFvlnhgpgIvZ6PORKuMXUdpFycA4SFVM9isrpo6lhKQp4JBMHbpzhZLwMd8RCpo5xvaDYxtajq1Vo1QHhVvDPgwJPRfLe6vNcaNdw8F3pWPSmtvJgTllU2R5ZtUYYMI52jysr3scOGhjZPY9nkcR59Pw915gyfeNOYqNolyUrJM9AIM_79r_0t-9m2hLsm7o20aoReY2WiMbRJSzgeFiFWp5CIps"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-8 text-white">
          <div class="flex items-center gap-2 mb-2">
            <span class="material-symbols-outlined text-blue-400">tsunami</span>
            <span class="font-label-md text-label-md uppercase tracking-wider text-blue-400 font-bold">Industri Berkelanjutan</span>
          </div>
          <h3 class="font-headline-md text-headline-md mb-2 text-2xl font-bold">Budidaya Perikanan</h3>
          <p class="font-body-md text-body-md opacity-90">Perikanan darat yang ramah lingkungan menyokong ketahanan ekonomi 30% kepala keluarga desa.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tourism (Wisata) Section -->
  <section class="py-section-padding-desktop bg-surface-container-low">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4">
        <div>
          <h2 class="font-headline-lg text-headline-lg text-primary mb-2">Destinasi Wisata</h2>
          <p class="font-body-lg text-body-lg text-on-surface-variant">Nikmati keindahan tersembunyi dari desa Desa Umbu Pabal.</p>
        </div>
        <a href="/galeri" class="flex items-center gap-2 text-primary font-label-md text-label-md hover:translate-x-1 transition-transform font-bold">
          Jelajahi Semua Tempat <span class="material-symbols-outlined">arrow_forward</span>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        <!-- Spot 1 -->
        <div class="bg-surface rounded-xl overflow-hidden border border-outline-variant hover:shadow-lg transition-shadow">
          <div class="h-64 relative overflow-hidden">
            <img 
              alt="Hidden Waterfall" 
              class="w-full h-full object-cover" 
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuA6jPu0n4gxWIFEYYwBHugUm1_9RhZ-pJFKSe30_2kVOIpIA9QP1ylKIKaRpV5C8poWeeD9FPbWhHxyIzA90W3jf_DULJihd8_GAPCFNbKphyWIb6eBZBDCfJiHLEebRRRIMCf9DeEaenHUDs0K9Aets_jXuaTEm2i6LAQ8yGWgnB7Q8Y6gZv-l2X1LHL0A6KFxq7LHRKjLc5ahmCg-ewQUtgBpJFxKh2_hhQTUhrIEZ45HtXlaaFOdQ-tJFp0MjOgN8BJq6-j7SMs"
            />
            <div class="absolute top-4 left-4 bg-secondary text-on-secondary px-3 py-1 rounded-full text-xs font-bold">NATURE</div>
          </div>
          <div class="p-6">
            <h4 class="font-headline-md text-headline-md mb-2 text-primary text-xl font-bold">Air Terjun Hijau</h4>
            <p class="font-body-md text-body-md text-on-surface-variant mb-4">Keindahan air terjun tiga tingkat yang tenang di tengah hutan dataran tinggi.</p>
            <div class="flex items-center text-on-surface-variant text-sm gap-4">
              <span class="flex items-center gap-1"><span class="material-symbols-outlined text-base">location_on</span> 2km dari Pusat Desa</span>
              <span class="flex items-center gap-1"><span class="material-symbols-outlined text-base text-amber-500">star</span> 4.9</span>
            </div>
          </div>
        </div>
        <!-- Spot 2 -->
        <div class="bg-surface rounded-xl overflow-hidden border border-outline-variant hover:shadow-lg transition-shadow">
          <div class="h-64 relative overflow-hidden">
            <img 
              alt="Traditional Village" 
              class="w-full h-full object-cover" 
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuC6Cj6Nn6OrfDxh0ZXqKL2cYFLjMOdEwulujkYmS_XTmXjGyesVDpWatmsT0YuX0KaVzIcnjqZCaLWjB1cMPIdsyrnBUGYEk5dcSTbFZT5ysSXHhoKaCat2o1R0tKdg-qUsayQ1zp-5IRGMbtQIHaXWMhRlN7cc8eVBmeImLkvtgp_KBgVv0nbbKBbgTYtDwure4lqZVz-xKWKA1mwIsPpt9YP7ymfcYlolIp91boscFQHrp_TMiVQwTcBch14PVDfJPStavvEpAeA"
            />
            <div class="absolute top-4 left-4 bg-secondary text-on-secondary px-3 py-1 rounded-full text-xs font-bold">CULTURE</div>
          </div>
          <div class="p-6">
            <h4 class="font-headline-md text-headline-md mb-2 text-primary text-xl font-bold">Kampung Budaya</h4>
            <p class="font-body-md text-body-md text-on-surface-variant mb-4">Rasakan kehidupan tradisional asli di kawasan cagar budaya yang terawat baik.</p>
            <div class="flex items-center text-on-surface-variant text-sm gap-4">
              <span class="flex items-center gap-1"><span class="material-symbols-outlined text-base">location_on</span> Inti Desa</span>
              <span class="flex items-center gap-1"><span class="material-symbols-outlined text-base text-amber-500">star</span> 4.8</span>
            </div>
          </div>
        </div>
        <!-- Spot 3 -->
        <div class="bg-surface rounded-xl overflow-hidden border border-outline-variant hover:shadow-lg transition-shadow">
          <div class="h-64 relative overflow-hidden">
            <img 
              alt="Mountain Peak" 
              class="w-full h-full object-cover" 
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDl4WoIFApe5iRx5ToqzsZQlRFTBjCqHwIeZAV7fX5WH24eEusfaHREXPCBjsT04WD6X0A2QNOxAsZUW5hqPq-Iv73NR4632wsFf9ucE4jym2m8gHxEclAkEirw31fkf9p9j07cstlVSbNX9-LB7DcdChBNAadiZg3zKrCZDE2sE2wZJKfb5sE_2LNsgMffM9KBRoFozQT5oqIZr1Xl2wmgKKrHhLdjppEdXIV60T6QGQSURZoZlrobAY7ViAR0gIB708VPIRVZl0Q"
            />
            <div class="absolute top-4 left-4 bg-secondary text-on-secondary px-3 py-1 rounded-full text-xs font-bold">ADVENTURE</div>
          </div>
          <div class="p-6">
            <h4 class="font-headline-md text-headline-md mb-2 text-primary text-xl font-bold">Jalur Puncak</h4>
            <p class="font-body-md text-body-md text-on-surface-variant mb-4">Jalur pendakian yang menantang dengan pemandangan 360 derajat atas seluruh lembah.</p>
            <div class="flex items-center text-on-surface-variant text-sm gap-4">
              <span class="flex items-center gap-1"><span class="material-symbols-outlined text-base">location_on</span> Puncak Utara</span>
              <span class="flex items-center gap-1"><span class="material-symbols-outlined text-base text-amber-500">star</span> 5.0</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- UMKM / SME Section -->
  <section class="py-section-padding-desktop max-w-container-max mx-auto px-gutter">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter items-center">
      <div class="lg:col-span-1">
        <h2 class="font-headline-lg text-headline-lg text-primary mb-4">Produk Unggulan UMKM</h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant mb-8">Dukung pengrajin lokal kami. Setiap pembelian berkontribusi langsung pada kas pemberdayaan ekonomi desa.</p>
        <div class="flex flex-col gap-4">
          <div class="flex items-center gap-4 p-4 glass-card rounded-xl">
            <span class="material-symbols-outlined text-secondary bg-secondary-container/30 p-3 rounded-full">shopping_basket</span>
            <div>
              <h5 class="font-label-md text-label-md text-primary font-bold">Pemberdayaan Lokal</h5>
              <p class="text-sm text-on-surface-variant">100+ UMKM Aktif</p>
            </div>
          </div>
          <div class="flex items-center gap-4 p-4 glass-card rounded-xl">
            <span class="material-symbols-outlined text-secondary bg-secondary-container/30 p-3 rounded-full">public</span>
            <div>
              <h5 class="font-label-md text-label-md text-primary font-bold">Kualitas Ekspor</h5>
              <p class="text-sm text-on-surface-variant">Produk bersertifikasi</p>
            </div>
          </div>
        </div>
      </div>
      <div class="lg:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-gutter">
        <!-- SME Product 1 -->
        <div class="group relative bg-surface p-4 rounded-xl border border-outline-variant flex gap-4 transition-all hover:-translate-y-1">
          <div class="w-32 h-32 rounded-lg overflow-hidden flex-shrink-0">
            <img 
              alt="Local Textile" 
              class="w-full h-full object-cover" 
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDnLSoXYxYyU0Fqw9gmAJaPP9ANoWN-myxiTMlnhpzcQimC97D17uFP0kPFZzA612TxZ42X-N3zIrKl0p4hc8kL5yyOsRrTixPweA-e35NJSs74_2cNtjEpS1QPj_JCMqw7OZE9j0rPYkrXmqLQotAJiw_xyf44dte6flkMPmqcApprZDC8ykj-ShdVeiA_-0wDHuISsLjMdzmsXiCVekr0xBdhgDP7ER77un-NxG1QU89BR_MXpuCYvf9FjHLim4TaDjv5NdQ1kUY"
            />
          </div>
          <div class="flex flex-col justify-center">
            <h4 class="font-headline-md text-headline-md text-sm mb-1 font-bold">Kain Tenun Ikat</h4>
            <p class="text-xs text-on-surface-variant mb-2">Dibuat manual dengan pewarna alami oleh Koperasi Wanita.</p>
            <span class="text-primary font-bold text-sm">Rp 250.000+</span>
          </div>
        </div>
        <!-- SME Product 2 -->
        <div class="group relative bg-surface p-4 rounded-xl border border-outline-variant flex gap-4 transition-all hover:-translate-y-1">
          <div class="w-32 h-32 rounded-lg overflow-hidden flex-shrink-0">
            <img 
              alt="Forest Honey" 
              class="w-full h-full object-cover" 
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuDTmgu0aspOTP5gy5vDmaLeOLskyOFjTDc7hOMUBZaqEEjOj_mgacXuQxQNNWNtoK6qw-yNrcp37_Xjzyq2C07R6wYkB3I1g7NflwuDRiqX_R6TbFiUVtGNmcIJfv7Jlf-0Lvu1dK-gS7trBXRF9o-2vRnZ_KsjKLYELDdZarP-qR9hU7BzpOBNRlqviaj1wGz79CORs1lPLtgd18-Ykty16FNA7FobiBuvhg6eSKx5mf7tKPDhoYqKkheXjvrATOzX5EHxcmy9rtk"
            />
          </div>
          <div class="flex flex-col justify-center">
            <h4 class="font-headline-md text-headline-md text-sm mb-1 font-bold">Madu Hutan Murni</h4>
            <p class="text-xs text-on-surface-variant mb-2">Madu liar asli yang dipanen dari pohon-pohon tinggi di dataran tinggi.</p>
            <span class="text-primary font-bold text-sm">Rp 85.000</span>
          </div>
        </div>
        <!-- SME Product 3 -->
        <div class="group relative bg-surface p-4 rounded-xl border border-outline-variant flex gap-4 transition-all hover:-translate-y-1">
          <div class="w-32 h-32 rounded-lg overflow-hidden flex-shrink-0">
            <img 
              alt="Specialty Coffee" 
              class="w-full h-full object-cover" 
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuBv8Y2biyZVXaJ5_saY5QpCkgoAydZiZMz84SnIcMJfeUcasz9cmlgAGymIWnu_uOdnI54rlnNgM6gGAz4F7eBEO_YUOBLDXJZQVoaXMbPp2im0IoUW_rut4vuZsQuQBro2W4SlDk7_klp4khWj5iHIXAB686ZudaP2fl4CWZ8fRL5SYasrbZjGipJXHNZesdK2H6Lq8yRtuylHl7vQ00Cp09QMrNGo79oQDRgyZornQNKSW6MeBSZKkIUWP5xJEZcjD6_QoZhPQW4"
            />
          </div>
          <div class="flex flex-col justify-center">
            <h4 class="font-headline-md text-headline-md text-sm mb-1 font-bold">Kopi Organik Arabika</h4>
            <p class="text-xs text-on-surface-variant mb-2">Kopi single-origin dengan cita rasa jeruk yang khas.</p>
            <span class="text-primary font-bold text-sm">Rp 120.000</span>
          </div>
        </div>
        <!-- SME Product 4 -->
        <div class="group relative bg-surface p-4 rounded-xl border border-outline-variant flex gap-4 transition-all hover:-translate-y-1">
          <div class="w-32 h-32 rounded-lg overflow-hidden flex-shrink-0">
            <img 
              alt="Bamboo Craft" 
              class="w-full h-full object-cover" 
              src="https://lh3.googleusercontent.com/aida-public/AB6AXuB9m3gnLBDVBKHs5hVTGxd7acTdenv0cRnk7ol5kvkmD6eNhGBgH8o1j4z8V6k8XqaPWBUeskwYv52EKLbYkKmoZsKIFYyYjZt33zIAS2M-_znJ2qlOfuGuq8zourgEbU8HHGPmewh-kyCDEVqTkreOkB_MbQO-gLxY0rzbT5_3I8Rz2bgmyhDdFUHf6NjXpy5RZVtOWAHkTMBCQ789BYYUCW-AmNa-iAfA62GAoDEMCN5svyBzGdGTkK2aYplresMSuM7LMJTWDDU"
            />
          </div>
          <div class="flex flex-col justify-center">
            <h4 class="font-headline-md text-headline-md text-sm mb-1 font-bold">Kerajinan Bambu Modern</h4>
            <p class="text-xs text-on-surface-variant mb-2">Peralatan dekorasi rumah berkelanjutan dengan gaya minimalis.</p>
            <span class="text-primary font-bold text-sm">Rp 150.000+</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-section-padding-desktop bg-primary text-on-primary">
    <div class="max-w-container-max mx-auto px-gutter">
