        <div>
          <span class="font-headline-xl text-headline-xl block mb-2 text-4xl font-bold">12</span>
          <span class="font-label-md text-label-md text-primary-fixed uppercase tracking-widest text-xs">Destinasi Wisata</span>
        </div>
        <div>
          <span class="font-headline-xl text-headline-xl block mb-2 text-4xl font-bold">450+</span>
