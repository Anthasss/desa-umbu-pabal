---
import Layout from "../../layouts/Layout.astro";
import { auth } from "../../lib/auth";

export const prerender = false;

const { id } = Astro.params;

let template = null;
try {
  const res = await fetch(`${Astro.url.origin}/api/templates/${id}`);
  if (res.ok) template = await res.json();
} catch {}

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});
---

<Layout title={`Template Surat - Desa Umbu Pabal`} activePage="layanan">
  <section class="max-w-[1200px] mx-auto px-gutter py-20">
    {!template ? (
      <div class="text-center py-20">
        <span class="material-symbols-outlined text-6xl text-on-surface-variant mb-4">search_off</span>
        <h1 class="font-headline-lg text-headline-lg text-on-surface mb-2">Template Tidak Ditemukan</h1>
        <p class="text-on-surface-variant mb-8">Template surat yang Anda cari tidak tersedia.</p>
        <a href="/layanan/surat-baru" class="bg-primary text-on-primary px-8 py-3 rounded-full font-label-md hover:opacity-90 transition-opacity inline-block font-bold">
          Kembali ke Layanan
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <a href="/layanan/surat-baru" class="inline-flex items-center gap-1 text-primary hover:underline mb-6 font-bold">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span> Kembali ke Layanan
          </a>

          <div class="bg-surface-bright rounded-2xl border border-outline-variant p-8">
            <div class="flex items-start gap-4 mb-6">
              <div class="w-14 h-14 bg-primary-fixed rounded-xl flex items-center justify-center text-primary shrink-0">
                <span class="material-symbols-outlined text-2xl">{template.fileType === "pdf" ? "picture_as_pdf" : "description"}</span>
              </div>
              <div>
                <h1 class="font-headline-lg text-headline-lg text-primary font-bold text-2xl">{template.title}</h1>
                <span class="inline-block px-2 py-0.5 bg-surface-container-high rounded text-xs text-on-surface-variant uppercase font-bold mt-1">{template.fileType}</span>
              </div>
            </div>

            {template.description && (
              <div class="mb-8">
                <h3 class="font-label-lg text-on-surface mb-2">Deskripsi</h3>
                <p class="text-on-surface-variant font-body-md leading-relaxed">{template.description}</p>
              </div>
            )}

            <div class="mb-8">
              <h3 class="font-label-lg text-on-surface mb-3">Langkah-langkah</h3>
              <ol class="space-y-3">
                <li class="flex items-start gap-3 text-on-surface-variant font-body-md">
                  <span class="w-6 h-6 bg-primary text-on-primary rounded-full flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">1</span>
                  Unduh template surat di bawah ini
                </li>
                <li class="flex items-start gap-3 text-on-surface-variant font-body-md">
                  <span class="w-6 h-6 bg-primary text-on-primary rounded-full flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">2</span>
                  Isi data sesuai format template dengan lengkap dan benar
                </li>
                <li class="flex items-start gap-3 text-on-surface-variant font-body-md">
                  <span class="w-6 h-6 bg-primary text-on-primary rounded-full flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">3</span>
                  Unggah surat yang sudah diisi melalui formulir di samping
                </li>
                <li class="flex items-start gap-3 text-on-surface-variant font-body-md">
                  <span class="w-6 h-6 bg-primary text-on-primary rounded-full flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">4</span>
                  Pantau status surat Anda di halaman layanan
                </li>
              </ol>
            </div>

            <a
              href={`/api/templates/download/${template.id}`}
              class="inline-flex items-center gap-2 bg-secondary text-on-secondary px-8 py-3 rounded-full font-label-md hover:opacity-90 transition-opacity font-bold"
            >
              <span class="material-symbols-outlined text-[18px]">download</span> Unduh Template
            </a>
          </div>
        </div>

        <div class="lg:col-span-1">
          <div class="bg-surface-bright rounded-2xl border border-outline-variant p-8 sticky top-24">
            <h2 class="font-headline-md text-headline-md text-primary font-bold text-lg mb-6">Kirim Surat</h2>

            {!session ? (
              <div class="text-center py-8">
                <span class="material-symbols-outlined text-4xl text-on-surface-variant mb-3">lock</span>
                <p class="text-on-surface-variant mb-4">Anda harus masuk terlebih dahulu untuk mengirim surat.</p>
                <a href="/login" class="bg-primary text-on-primary px-6 py-2.5 rounded-full font-label-md hover:opacity-90 transition-opacity inline-block font-bold">
                  Masuk
                </a>
              </div>
            ) : (
              <form id="submit-form">
              <div class="mb-4">
                <label for="letter-file" class="block font-label-md text-on-surface mb-2">File Surat (PDF/DOCX, max 10MB)</label>
                <input
                  type="file"
                  id="letter-file"
                  accept=".pdf,.docx"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-outline bg-surface text-on-surface font-body-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-bold file:bg-primary-container file:text-on-primary-container hover:file:opacity-80"
                />
              </div>

              <div id="submit-error" class="hidden mb-4 p-3 bg-error-container text-on-error-container rounded-xl text-sm"></div>
              <div id="submit-success" class="hidden mb-4 p-3 bg-green-100 text-green-800 rounded-xl text-sm"></div>

              <button
                type="submit"
                id="submit-btn"
                class="w-full bg-primary text-on-primary py-3 rounded-full font-label-md hover:opacity-90 transition-all active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed font-bold cursor-pointer"
              >
                Kirim Surat
              </button>
            </form>
            )}
          </div>
        </div>
      </div>
    )}
  </section>

  <script is:inline define:vars={{ templateId: id }}>
    document.getElementById("submit-form")?.addEventListener("submit", async function (e) {
      e.preventDefault();
      const fileInput = document.getElementById("letter-file");
      const btn = document.getElementById("submit-btn");
      const errorDiv = document.getElementById("submit-error");
      const successDiv = document.getElementById("submit-success");

      errorDiv.classList.add("hidden");
      successDiv.classList.add("hidden");

      if (!fileInput.files.length) {
        errorDiv.textContent = "Pilih file terlebih dahulu.";
        errorDiv.classList.remove("hidden");
        return;
      }

      const file = fileInput.files[0];
      const allowedTypes = ["application/pdf", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"];
      if (!allowedTypes.includes(file.type)) {
        errorDiv.textContent = "Hanya file PDF dan DOCX yang diizinkan.";
        errorDiv.classList.remove("hidden");
        return;
      }
      if (file.size > 10 * 1024 * 1024) {
        errorDiv.textContent = "Ukuran file maksimal 10MB.";
        errorDiv.classList.remove("hidden");
        return;
      }

      btn.disabled = true;
      btn.textContent = "Mengirim...";

      const formData = new FormData();
      formData.append("templateId", templateId);
      formData.append("file", file);

      try {
        const res = await fetch("/api/letters", { method: "POST", body: formData });
        const data = await res.json();

        if (!res.ok) {
          errorDiv.textContent = data.error || "Gagal mengirim surat.";
          errorDiv.classList.remove("hidden");
          btn.disabled = false;
          btn.textContent = "Kirim Surat";
          return;
        }

        successDiv.textContent = "Surat berhasil dikirim! Anda dapat memantau statusnya di halaman layanan.";
        successDiv.classList.remove("hidden");
        fileInput.value = "";
        btn.disabled = false;
        btn.textContent = "Kirim Surat";
      } catch {
        errorDiv.textContent = "Terjadi kesalahan. Coba lagi nanti.";
        errorDiv.classList.remove("hidden");
        btn.disabled = false;
        btn.textContent = "Kirim Surat";
      }
    });
  </script>
</Layout>
