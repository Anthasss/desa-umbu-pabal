---
import Layout from "../layouts/Layout.astro";
import { auth } from "../lib/auth";
import { db } from "../db";
import { galleryImages } from "../db/schema";
import Hero from "../components/galeri/hero.astro";
import { desc } from "drizzle-orm";

export const prerender = false;

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

const dbImages = await db
  .select()
  .from(galleryImages)
  .orderBy(desc(galleryImages.createdAt));

const galleryItems = dbImages.map((img) => ({
  id: img.id,
  title: img.title,
  imageUrl: img.imageUrl,
}));
---

<Layout title="Galeri Desa - Desa Umbu Pabal" activePage="galeri" session={session}>
  <Hero />

  <!-- Category Filter -->
  <!-- <div class="bg-surface-container-low py-4 mb-8 px-6 sticky top-20 z-40"> -->
  <!--   <div -->
  <!--     class="max-w-[1200px] mx-auto flex gap-4 overflow-x-auto no-scrollbar justify-end" -->
  <!--   > -->
  <!--     { -->
  <!--       categories.map((cat) => ( -->
  <!--         <button -->
  <!--           class="filter-btn px-6 py-2 rounded-full font-label-md text-label-md whitespace-nowrap transition-colors" -->
  <!--           class:list={[ -->
  <!--             cat.value === "all" -->
  <!--               ? "bg-primary text-on-primary" -->
  <!--               : "bg-surface text-on-surface-variant border border-outline-variant hover:bg-primary-fixed hover:text-on-primary-fixed", -->
  <!--           ]} -->
  <!--           data-category={cat.value} -->
  <!--         > -->
  <!--           {cat.label} -->
  <!--         </button> -->
  <!--       )) -->
  <!--     } -->
  <!--   </div> -->
  <!-- </div> -->

  <!-- Gallery Grid -->
  <section class="max-w-[1200px] mx-auto px-6 py-section-padding-desktop pt-0">
    <div
      id="gallery-grid"
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4"
    >
    </div>

    <!-- Sentinel for infinite scroll -->
    <div
      id="scroll-sentinel"
      class="h-12 flex items-center justify-center mt-4"
    >
      <div
        id="loading-indicator"
        class="hidden flex-col items-center justify-center gap-2 py-4"
      >
        <div
          class="w-8 h-8 rounded-full border-4 border-outline-variant border-t-primary animate-spin"
        >
        </div>
        <span class="text-on-surface-variant font-body-md text-sm"
          >Memuat foto</span
        >
      </div>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ galleryItems }}>
  const PAGE_SIZE = 9;
  let currentPage = 0;
  let isLoading = false;

  const grid = document.getElementById("gallery-grid");
  const sentinel = document.getElementById("scroll-sentinel");
  const loadingIndicator = document.getElementById("loading-indicator");

  function createCard(item) {
    const card = document.createElement("div");
    card.className =
      "gallery-card group relative overflow-hidden rounded-xl bg-surface-container shadow-sm cursor-pointer aspect-square";
    card.innerHTML = `
      <img
        src="/api/gallery/image/${item.id}?v=${encodeURIComponent(item.imageUrl)}"
        alt="${item.title}"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent flex items-end p-4">
        <h3 class="text-white font-bold text-sm leading-tight">${item.title}</h3>
      </div>
    `;
    return card;
  }

  function loadNextPage() {
    const start = currentPage * PAGE_SIZE;
    const end = start + PAGE_SIZE;
    const slice = galleryItems.slice(start, end);

    if (slice.length === 0) {
      observer.disconnect();
      loadingIndicator.classList.add("hidden");
      loadingIndicator.classList.remove("flex");
      return;
    }

    isLoading = true;
    loadingIndicator.classList.remove("hidden");
    loadingIndicator.classList.add("flex");

    setTimeout(() => {
      slice.forEach((item) => grid.appendChild(createCard(item)));
      currentPage++;
      isLoading = false;
      loadingIndicator.classList.add("hidden");
      loadingIndicator.classList.remove("flex");

      if (currentPage * PAGE_SIZE >= galleryItems.length) {
        observer.disconnect();
      }
    }, 600);
  }

  const observer = new IntersectionObserver(
    (entries) => {
      if (entries[0].isIntersecting && !isLoading) {
        loadNextPage();
      }
    },
    { rootMargin: "200px" },
  );

  observer.observe(sentinel);
  loadNextPage();
</script>
