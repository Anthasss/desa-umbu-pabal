---
import "../styles/global.css";

interface Props {
  title: string;
  activePage?: string;
  session?: { user: { name: string } } | null;
}

const { title, activePage = "home", session = null } = Astro.props;

const avatarName = session?.user?.name || "";
const avatarUrl = avatarName
  ? `https://ui-avatars.com/api/?name=${encodeURIComponent(avatarName)}&background=012d1d&color=fff&bold=true`
  : "";

const navItems = [
  { page: "home", label: "Home", href: "/" },
  { page: "tentangKami", label: "Tentang Kami", href: "/tentang" },
  // { page: "ekonomi", label: "Ekonomi", href: "/ekonomi" },
  { page: "berita", label: "Berita", href: "/berita" },
  // { page: "event", label: "Event", href: "/event" },
  { page: "galeri", label: "Galeri", href: "/galeri" },
  // { page: "budaya", label: "Budaya", href: "/budaya" },
];

const layananItems = [
  { label: "Surat Saya", href: "/layanan", icon: "mail" },
  { label: "Kirim Surat", href: "/layanan/surat-baru", icon: "edit_document" },
  { label: "Kotak Saran", href: "/layanan/kotak-saran", icon: "feedback" },
];
---

<!doctype html>
<html class="light" lang="id">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{title}</title>
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
    <link rel="icon" href="/lambang-sumba-tengah.ico" />
    <meta name="generator" content={Astro.generator} />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Inter:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-background text-on-surface font-body-md overflow-x-hidden">
    <!-- TopNavBar -->
    <header
      class="fixed top-0 w-full z-50 bg-surface border-b border-outline-variant shadow-sm transition-all duration-300"
    >
      <nav
        class="max-w-container-max mx-auto px-gutter flex justify-between items-center h-20"
      >
        <div class="flex gap-4 items-center">
          <img
            src="/lambang-sumba-tengah.png"
            alt="lambang-sumba-tengah"
            class="w-auto h-12"
          />
          <div
            class="text-base md:font-headline-md md:text-headline-md font-bold text-primary"
          >
            Desa Umbu Pabal
          </div>
        </div>
        <div class="flex justify-end items-center gap-6">
          <div class="hidden lg:flex gap-6 items-center">
            {
              navItems.map((item) => (
                <a
                  class={`font-body-md text-body-md transition-colors ${
                    activePage === item.page
                      ? "text-primary font-bold border-b-2 border-primary pb-1"
                      : "text-on-surface-variant hover:text-primary"
                  }`}
                  href={item.href}
                >
                  {item.label}
                </a>
              ))
            }
            <div class="relative group" id="layanan-dropdown">
              <button
                class={`font-body-md text-body-md transition-colors flex items-center gap-1 cursor-pointer ${
                  activePage === "layanan"
                    ? "text-primary font-bold border-b-2 border-primary pb-1"
                    : "text-on-surface-variant hover:text-primary"
                }`}
              >
                Layanan
                <span
                  class="material-symbols-outlined text-[16px] transition-transform group-hover:rotate-180"
                  >expand_more</span
                >
              </button>
              <div
                class="absolute top-full left-0 pt-2 hidden group-hover:block z-50"
              >
                <div
                  class="bg-surface rounded-xl shadow-[0px_8px_30px_rgba(0,0,0,0.12)] border border-outline-variant py-2 min-w-[200px]"
                >
                  {
                    layananItems.map((item) => (
                      <a
                        class="flex items-center gap-3 px-4 py-2.5 text-on-surface-variant hover:bg-surface-container-low hover:text-primary transition-colors font-body-md"
                        href={item.href}
                      >
                        <span class="material-symbols-outlined text-[18px]">
                          {item.icon}
                        </span>
                        {item.label}
                      </a>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-3">
            {
              session ? (
                <a
                  href="/dashboard"
                  class="block rounded-full overflow-hidden w-10 h-10 hover:opacity-80 transition-all active:scale-95"
                >
                  <img
                    src={avatarUrl}
                    alt={avatarName}
                    class="w-10 h-10 rounded-full"
                  />
                </a>
              ) : (
                <a
                  href="/dashboard"
                  class="bg-primary text-on-primary px-5 py-2.5 rounded-full font-label-md hover:opacity-80 transition-all active:scale-95 block text-center"
                >
                  Masuk
                </a>
              )
            }
            <!-- Mobile menu toggle button -->
            <button
              id="mobile-menu-toggle"
              class="lg:hidden p-2 text-on-surface-variant hover:text-primary focus:outline-none"
            >
              <span class="material-symbols-outlined text-3xl">menu</span>
            </button>
          </div>
        </div>
      </nav>

      <!-- Mobile Navigation Drawer -->
      <div
        id="mobile-menu"
        class="lg:hidden w-full bg-surface border-t border-outline-variant py-4 px-gutter flex flex-col gap-4 shadow-inner"
      >
        {
          navItems.map((item) => (
            <a
              class={`font-body-md text-body-md transition-colors ${
                activePage === item.page
                  ? "text-primary font-bold border-b-2 border-primary pb-1"
                  : "text-on-surface-variant hover:text-primary"
              }`}
              href={item.href}
            >
              {item.label}
            </a>
          ))
        }
        <div class="flex flex-col gap-2">
          <span
            class={`font-body-md text-body-md font-bold ${activePage === "layanan" ? "text-primary" : "text-on-surface-variant"}`}
          >
            Layanan
          </span>
          <div class="flex flex-col pl-4 gap-2">
            {
              layananItems.map((item) => (
                <a
                  class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors flex items-center gap-2"
                  href={item.href}
                >
                  <span class="material-symbols-outlined text-[16px]">
                    {item.icon}
                  </span>
                  {item.label}
                </a>
              ))
            }
          </div>
        </div>
        {
          session ? (
            <a href="/dashboard" class="flex justify-center">
              <img
                src={avatarUrl}
                alt={avatarName}
                class="w-10 h-10 rounded-full"
              />
            </a>
          ) : (
            <a
              href="/dashboard"
              class="bg-primary text-on-primary px-5 py-2.5 rounded-full font-label-md text-center hover:opacity-80 transition-all active:scale-95"
            >
              Masuk
            </a>
          )
        }
      </div>
    </header>

    <!-- Main Content spacing top since header is fixed -->
    <main class="pt-20">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-primary w-full">
      <div
        class="max-w-container-max mx-auto px-gutter py-section-padding-desktop flex flex-col md:flex-row justify-between gap-base"
      >
        <div class="max-w-xs">
          <div
            class="font-headline-md text-headline-md font-bold text-on-primary mb-6"
          >
            Desa Umbu Pabal
          </div>
          <p class="text-primary-fixed -dim font-body-md opacity-80">
            Kawasan Pusat Pemerintahan Desa Desa Umbu Pabal, Kec. Alam Subur,
            Kab. Lestari, Indonesia 65432.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-12">
          <div class="flex flex-col gap-4">
            <h5 class="text-on-primary font-bold mb-2">Navigasi</h5>
            <a
              class="text-primary-fixed -dim hover:text-white transition-colors"
              href="/">Home</a
            >
            <a
              class="text-primary-fixed -dim hover:text-white transition-colors"
              href="/tentang">Tentang Desa</a
            >
          </div>
          <div class="flex flex-col gap-4">
            <h5 class="text-on-primary font-bold mb-2">Publikasi</h5>
            <a
              class="text-primary-fixed -dim hover:text-white transition-colors"
              href="/berita">Berita</a
            >
            <a
              class="text-primary-fixed -dim hover:text-white transition-colors"
              href="/galeri">Galeri</a
            >
            <a
              class="text-primary-fixed -dim hover:text-white transition-colors"
              href="/layanan">Layanan</a
            >
          </div>
        </div>
        <div class="flex flex-col gap-6">
          <h5 class="text-on-primary font-bold">Ikuti Kami</h5>
          <div class="flex gap-4">
            <a
              class="w-10 h-10 rounded-full border border-primary-fixed flex items-center justify-center text-on-primary hover:bg-on-primary hover:text-primary transition-all active:scale-95"
              href="#"
            >
              <span class="material-symbols-outlined">share</span>
            </a>
            <a
              class="w-10 h-10 rounded-full border border-primary-fixed flex items-center justify-center text-on-primary hover:bg-on-primary hover:text-primary transition-all active:scale-95"
              href="#"
            >
              <span class="material-symbols-outlined">public</span>
            </a>
          </div>
        </div>
      </div>
      <div
        class="max-w-container-max mx-auto px-gutter py-8 border-t border-primary-container flex justify-center"
      >
        <p class="text-primary-fixed -dim font-body-md text-sm opacity-60">
          © {new Date().getFullYear()} Desa Umbu Pabal. All rights reserved.
        </p>
      </div>
    </footer>

    <script>
      // Header effect
      window.addEventListener("scroll", () => {
        const scrolled = window.pageYOffset;
        const nav = document.querySelector("header");
        if (nav) {
          if (scrolled > 50) {
            nav.classList.add("shadow-md", "bg-opacity-95");
          } else {
            nav.classList.remove("shadow-md", "bg-opacity-95");
          }
        }
      });

      // Mobile Menu Toggle logic
      const toggleBtn = document.getElementById("mobile-menu-toggle");
      const mobileMenu = document.getElementById("mobile-menu");

      if (toggleBtn && mobileMenu) {
        toggleBtn.addEventListener("click", () => {
          mobileMenu.classList.toggle("hidden");
          const icon = toggleBtn.querySelector("span");
          if (icon) {
            icon.textContent = mobileMenu.classList.contains("hidden")
              ? "menu"
              : "close";
          }
        });
      }
    </script>
  </body>
</html>
